function drawGarlic(z, yy) {
  const bx = z.x;
  const by = yy - 8;

  ctx.fillStyle = '#f3f0e2';
  ctx.beginPath();
  ctx.ellipse(bx, by + 1, 15, 16, 0, 0, Math.PI * 2);
  ctx.fill();

  ctx.strokeStyle = 'rgba(150, 140, 110, 0.55)';
  ctx.lineWidth = 1.4;
  for (let i = -1; i <= 1; i++) {
    ctx.beginPath();
    ctx.moveTo(bx + i * 7, by - 13);
    ctx.quadraticCurveTo(bx + i * 9, by + 2, bx + i * 6, by + 14);
    ctx.stroke();
  }

  ctx.fillStyle = '#c9d69a';
  ctx.beginPath();
  ctx.moveTo(bx - 3, by - 15);
  ctx.quadraticCurveTo(bx, by - 28, bx + 5, by - 17);
  ctx.closePath();
  ctx.fill();

  if (z.biteFlash > GARLIC_INTERVAL - 0.5) {
    const k = (GARLIC_INTERVAL - z.biteFlash) / 0.5;
    ctx.globalAlpha = Math.max(0, 1 - k);
    ctx.fillStyle = '#f7f5ec';
    ctx.beginPath();
    ctx.arc(bx + 14 - k * 12, by - 10 - k * 10, 2.4, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalAlpha = 1;
  }
}

function drawGramoHead(z, yy) {
