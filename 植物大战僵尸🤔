let masterVolume = 0.7;
let eliteMode = 'normal';

const SETTINGS_KEY = 'lawn_settings_v1';

function loadSettings() {
  try {
    const raw = localStorage.getItem(SETTINGS_KEY);
    if (!raw) return;
    const d = JSON.parse(raw);
    if (typeof d.volume === 'number') {
      masterVolume = Math.max(0, Math.min(1, d.volume));
    }
    if (d.elite === 'all' || d.elite === 'none' || d.elite === 'normal') {
      eliteMode = d.elite;
    }
  } catch (e) {}
}

function saveSettings() {
  try {
    localStorage.setItem(SETTINGS_KEY, JSON.stringify({
      volume: masterVolume,
      elite: eliteMode
    }));
  } catch (e) {}
}

function eliteRoll() {
  if (eliteMode === 'all') return true;
  if (eliteMode === 'none') return false;
  return Math.random() < ELITE_CHANCE;
}

function pickEliteFrom(pool) {
  if (!pool || !pool.length) return null;
  return pool[Math.floor(Math.random() * pool.length)];
}

function pickCarry(poolName) {
  const pool = ELITE_POOLS[poolName];
  if (!pool || !pool.length) return 'normal';
  if (eliteMode === 'none') return 'normal';
  if (eliteMode === 'all') return pickEliteFrom(pool);
  if (Math.random() < ELITE_CHANCE) return pickEliteFrom(pool);
  return 'normal';
}

/* 全精英模式下的强制升格：精英保持，基础型换成对应精英 */
function forceEliteType(type) {
  if (type.indexOf('elite_') === 0) return type;
  const pool = ELITE_POOLS[type];
  if (!pool || !pool.length) return type;
  return pool[Math.floor(Math.random() * pool.length)];
}

