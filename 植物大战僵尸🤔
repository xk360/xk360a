function drawArmorHat(z, yy) {
  const kind = z.def.hatKind || (z.type === 'bucket' ? 'bucket' : 'cone');
  const fill = z.def.hatColor || (kind === 'bucket' ? '#9e9e9e' : '#c98a4b');

  if (z.def.hatGlow) {
    const g = ctx.createRadialGradient(z.x, yy - 25, 1, z.x, yy - 25, 30);
    g.addColorStop(0, z.def.hatGlow);
    g.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.save();
    ctx.globalAlpha = 0.42 + 0.24 * Math.sin(performance.now() / 260);
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(z.x, yy - 25, 30, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  ctx.fillStyle = fill;
  ctx.beginPath();
  if (kind === 'cone') {
    ctx.moveTo(z.x, yy - 44);
    ctx.lineTo(z.x + 15, yy - 18);
    ctx.lineTo(z.x - 15, yy - 18);
    ctx.closePath();
  } else {
    ctx.moveTo(z.x - 13, yy - 42);
    ctx.lineTo(z.x + 13, yy - 42);
    ctx.lineTo(z.x + 15, yy - 19);
    ctx.lineTo(z.x - 15, yy - 19);
    ctx.closePath();
  }
  ctx.fill();

  ctx.strokeStyle = 'rgba(0,0,0,0.38)';
  ctx.lineWidth = 1.4;
  ctx.stroke();

  ctx.fillStyle = 'rgba(255,255,255,0.22)';
  ctx.fillRect(z.x - 9, yy - 38, 4, kind === 'cone' ? 10 : 13);

  if (kind === 'bucket') {
    ctx.strokeStyle = 'rgba(255,255,255,0.3)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(z.x - 13, yy - 31);
    ctx.lineTo(z.x + 13, yy - 31);
    ctx.stroke();
  }

  if (z.def.hatBadge) {
    ctx.fillStyle = z.def.hatBadge;
    ctx.beginPath();
    ctx.moveTo(z.x - 4, yy - 37);
    ctx.lineTo(z.x + 4, yy - 37);
    ctx.lineTo(z.x + 5, yy - 26);
    ctx.lineTo(z.x - 5, yy - 26);
    ctx.closePath();
    ctx.fill();
    ctx.strokeStyle = 'rgba(0,0,0,0.4)';
    ctx.lineWidth = 1;
    ctx.stroke();
  }
}

function drawDoor(z, yy) {
  const w = 17;
  const h = 54;
  const x = z.x - 30;
  const top = yy - 24;
  const fill = z.def.doorColor || '#8d8f8a';

  ctx.fillStyle = fill;
  ctx.fillRect(x, top, w, h);

  ctx.strokeStyle = 'rgba(0,0,0,0.42)';
  ctx.lineWidth = 1.5;
  ctx.strokeRect(x, top, w, h);

  ctx.strokeStyle = 'rgba(255,255,255,0.22)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(x + 3, top + 10);
  ctx.lineTo(x + w - 3, top + 10);
  ctx.moveTo(x + 3, top + 30);
  ctx.lineTo(x + w - 3, top + 30);
  ctx.stroke();

  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  const rivets = [[4, 5], [w - 4, 5], [4, h - 6], [w - 4, h - 6]];
  for (const r of rivets) {
    ctx.beginPath();
    ctx.arc(x + r[0], top + r[1], 1.6, 0, Math.PI * 2);
    ctx.fill();
  }

  const ratio = z.armor2 / (z.def.armor2 || 1);
  if (ratio < 0.67) {
    ctx.strokeStyle = 'rgba(20,20,20,0.55)';
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(x + w * 0.5, top + 4);
    ctx.lineTo(x + w * 0.36, top + 24);
    ctx.lineTo(x + w * 0.62, top + 40);
    ctx.stroke();
  }
  if (ratio < 0.34) {
    ctx.beginPath();
    ctx.moveTo(x + w * 0.2, top + 8);
    ctx.lineTo(x + w * 0.44, top + 26);
    ctx.lineTo(x + w * 0.24, top + 46);
    ctx.stroke();
  }
}

function drawTracksuit(x, y, chilled) {
  const red = chilled ? '#b3525c' : TRACKSUIT_RED;
  const left = x - 13;
  const width = 26;
  const height = 27;

  ctx.fillStyle = red;
  ctx.fillRect(left, y, width, height);

  ctx.fillStyle = chilled ? 'rgba(90, 140, 170, 0.45)' : 'rgba(0,0,0,0.16)';
  ctx.fillRect(left, y + height - 5, width, 5);

  ctx.fillStyle = 'rgba(255,255,255,0.94)';
  ctx.fillRect(left + 3, y, 3, height);
  ctx.fillRect(left + width - 6, y, 3, height);

  ctx.fillStyle = 'rgba(255,255,255,0.96)';
  ctx.fillRect(left + 5, y, width - 10, 3);
}

function drawCarriedZombie(type, cx, cy) {
  const def = ZOMBIE_TYPES[type];

  let body = '#8d9b7a';
  if (type === 'elite_note') body = '#e8d79b';
  else if (type === 'elite_garlic') body = '#e6efd8';
  else if (type === 'elite_rage') body = '#c2453a';
  else if (type === 'elite_bucket_gold') body = '#e0b02a';
  else if (type === 'elite_bucket_green') body = '#4f9e52';
  else if (type === 'elite_flag_sun') body = '#f9a825';
  else if (type === 'elite_flag_road') body = '#c2453a';
  else if (type === 'bucket') body = '#9e9e9e';

  if (def && def.poleTier) body = TRACKSUIT_RED;

  ctx.fillStyle = body;
  ctx.beginPath();
  ctx.arc(cx, cy - 6, 8, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillRect(cx - 5, cy + 2, 10, 13);

  if (type === 'elite_note') {
    ctx.fillStyle = '#f2e3a0';
    ctx.fillRect(cx - 8, cy - 15, 16, 12);
  } else if (type === 'elite_garlic') {
    ctx.fillStyle = '#f3f0e2';
    ctx.beginPath();
    ctx.ellipse(cx + 8, cy + 2, 4, 5, 0, 0, Math.PI * 2);
    ctx.fill();
  }
}

function drawCarriedPlant(type, cx, cy) {
  const def = PLANT_TYPES[type] || PLANT_TYPES.sunflower;
  const im = PLANT_IMG[type];

  if (im) {
    const sw = im.naturalWidth;
    const sh = im.naturalHeight;
    if (sw > 0 && sh > 0) {
      const k = Math.min(28 / sw, 28 / sh);
      ctx.drawImage(im, cx - sw * k / 2, cy - sh * k / 2, sw * k, sh * k);
      return;
    }
  }

  ctx.font = '24px ' + EMOJI;
  ctx.fillText(def.icon, cx, cy);
}

function drawThief(z) {
  if (z.dead) return;

  const steal = z.def.thief === 'steal';

  if (steal && z.thiefStage === 'mark') {
    const k = Math.min(1, z.thiefT / THIEF_MARK);
    const ty = z.targetY - 300 + 300 * k;
    const r = 13;

    ctx.fillStyle = '#f4f1e6';
    ctx.beginPath();
    ctx.arc(z.targetX, ty, r, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = '#c2453a';
    ctx.beginPath();
    ctx.arc(z.targetX, ty, r * 0.66, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = '#f4f1e6';
    ctx.beginPath();
    ctx.arc(z.targetX, ty, r * 0.32, 0, Math.PI * 2);
    ctx.fill();

    ctx.strokeStyle = 'rgba(255, 240, 200, 0.8)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(z.targetX, ty - r);
    ctx.lineTo(z.targetX, ty - r - 26);
    ctx.stroke();
    return;
  }

  const baseX = steal ? z.targetX : z.x;
  const baseY = steal ? (z.targetY - HOVER_LIFT) : z.y;
  const cy = baseY - z.dropLift;
  const cx = baseX;

  const icy = z.slowTimer > 0;

  ctx.strokeStyle = 'rgba(214, 196, 150, 0.9)';
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(cx, -20);
  ctx.lineTo(cx, cy - 24);
  ctx.stroke();

  ctx.fillStyle = icy ? '#5f7f92' : '#3f4a3c';
  ctx.beginPath();
  ctx.arc(cx, cy - 12, 11, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillRect(cx - 9, cy - 2, 18, 18);

  ctx.fillStyle = icy ? '#bfe3f0' : '#d7cfa8';
  ctx.beginPath();
  ctx.arc(cx, cy - 12, 6, 0, Math.PI * 2);
  ctx.fill();

  if (!steal) {
    if (z.thiefStage === 'descend') {
      drawCarriedZombie(z.carryType || 'normal', cx + 22, cy + 12);
      ctx.strokeStyle = 'rgba(190, 180, 150, 0.9)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(cx + 8, cy + 2);
      ctx.lineTo(cx + 16, cy + 8);
      ctx.stroke();
    }
  } else if (z.thiefStage === 'lift' && z.stolen) {
    drawCarriedPlant(z.targetPlantType, cx + 22, cy + 14);
    ctx.strokeStyle = 'rgba(190, 180, 150, 0.9)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(cx + 8, cy + 2);
    ctx.lineTo(cx + 16, cy + 8);
    ctx.stroke();
  }

  if (steal && z.thiefStage === 'hover') {
    ctx.strokeStyle = 'rgba(255, 213, 79, 0.8)';
    ctx.lineWidth = 2;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.arc(z.targetX, z.targetY, 34, 0, Math.PI * 2);
    ctx.stroke();
    ctx.setLineDash([]);

    const bodyMax = z.def.hp || 1;
    const bodyRatio = z.hp / bodyMax;

    const armorMax = z.def.armor || 0;
    const armorRatio = armorMax > 0 ? z.armor / armorMax : 0;

    if (bodyRatio > 0 && bodyRatio < 1) {
      drawHpBar(cx, cy - 32, 34, bodyRatio, '#e57373');
    }
    if (armorMax > 0 && armorRatio > 0 && armorRatio < 1) {
      drawHpBar(cx, cy - 38, 34, armorRatio, '#b0b0b0');
    }
  }
}

function drawZombies() {
  for (const z of game.zombies) {
    if (z.def.thief) {
      drawThief(z);
      continue;
    }

    const dying = z.dead;
    const bob = dying ? 0 : Math.sin(z.walkPhase) * 2;
    const yy = z.y + bob - (z.jumpLift || 0);

    ctx.fillStyle = 'rgba(0,0,0,0.22)';
    ctx.beginPath();
    ctx.ellipse(z.x, z.y + 26, 15, 5, 0, 0, Math.PI * 2);
    ctx.fill();

    if (z.shifting) {
      ctx.save();
      ctx.strokeStyle = 'rgba(190, 235, 255, 0.55)';
      ctx.lineWidth = 2;
      ctx.setLineDash([4, 5]);
      ctx.beginPath();
      ctx.moveTo(z.x, z.y - z.shiftY);
      ctx.lineTo(z.x, z.y);
      ctx.stroke();
      ctx.restore();
    }

    ctx.save();

    if (dying) {
      const k = Math.min(1, z.dieT / z.dieDur);
      const ease = 1 - (1 - k) * (1 - k);
      ctx.translate(z.x, z.y + 26);
      ctx.rotate(ease * Math.PI * 0.46);
      ctx.globalAlpha = Math.max(0, 1 - ease * 0.9);
      ctx.translate(-z.x, -(z.y + 26));
    }

    let headColor = z.def.headColor || z.def.color;
    if (z.enraged) headColor = '#b8362a';
    if (z.roadBuffed) headColor = BUFFED_HEAD;
    if (z.friendly) headColor = '#ff8ad8';

    const torsoColor = z.slowTimer > 0 ? '#7fc9e8' : headColor;
    const iconHead = HEAD_ICON[z.type] === 1;

    if (!iconHead) {
      ctx.fillStyle = headColor;
      ctx.beginPath();
      ctx.arc(z.x, yy - 8, 17, 0, Math.PI * 2);
      ctx.fill();
    }

    if (z.type === 'elite_hair') drawHair(z, yy);
    if (z.type === 'elite_pole2' && z.hasPole) drawDoublePole(z, yy);
    if (z.type === 'elite_poleinf' && z.hasPole) drawGoldPole(z, yy);
    if (z.type === 'elite_poleflag' && z.hasPole) drawFlagPole(z, yy);
    if (z.type === 'pole' && z.hasPole) drawPoleStaff(z, yy);

    if (z.isPole) {
      drawTracksuit(z.x, yy + 6, z.slowTimer > 0);
    } else {
      ctx.fillStyle = torsoColor;
      ctx.fillRect(z.x - 12, yy + 6, 24, 26);
    }

    if (z.armor > 0) drawArmorHat(z, yy);

    if (z.armor2 > 0) drawDoor(z, yy);

    if (z.type === 'elite_note') drawNoteHead(z, yy);
    if (z.type === 'elite_garlic') drawGarlic(z, yy);
    if (z.type === 'elite_gramo') drawGramoHead(z, yy);
    if (z.type === 'elite_target') drawTargetHead(z, yy);
    if (z.type === 'elite_flag_sun') drawSunHead(z, yy);

    if (z.type === 'flag' || z.def.flagCount) drawFlag(z, yy);

    ctx.restore();

    if (z.goldShieldT > 0) {
      ctx.save();
      ctx.globalAlpha = 0.32 + 0.26 * Math.abs(Math.sin(performance.now() / 90));
      ctx.strokeStyle = '#ffe082';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.arc(z.x, yy - 6, 27, 0, Math.PI * 2);
      ctx.stroke();
      ctx.restore();
    }

    if (!dying) {
      const bodyMax = z.def.hp || 1;
      const bodyRatio = z.hp / bodyMax;

      const armorMax = z.def.armor || 0;
      const armorRatio = armorMax > 0 ? z.armor / armorMax : 0;

      const doorMax = z.def.armor2 || 0;
      const doorRatio = doorMax > 0 ? z.armor2 / doorMax : 0;

      if (bodyRatio > 0 && bodyRatio < 1) {
        drawHpBar(z.x, yy - 52, 36, bodyRatio,
          z.enraged ? '#ff7043' : (z.def.healAura ? '#8de39a' : '#e57373'));
      }

      if (armorMax > 0 && armorRatio > 0 && armorRatio < 1) {
        const kind = z.def.hatKind || (z.type === 'bucket' ? 'bucket' : 'cone');
        let armorColor = kind === 'bucket' ? '#b0b0b0' : '#c98a4b';
        if (z.def.hatColor) armorColor = z.def.hatColor;
        drawHpBar(z.x, yy - 58, 36, armorRatio, armorColor);
      }

      if (doorMax > 0 && doorRatio > 0 && doorRatio < 1) {
        drawHpBar(z.x, yy - 64, 36, doorRatio, '#9aa0a6');
      }
    }
  }
}

function drawVaultTrails() {
  for (const v of game.vaultTrails) {
    const k = 1 - v.t / v.life;
    ctx.save();
    ctx.globalAlpha = Math.max(0, 1 - k) * 0.85;
    ctx.strokeStyle = '#ffe082';
    ctx.lineWidth = 2;
    ctx.setLineDash([6, 6]);
    ctx.beginPath();
    const midX = (v.x1 + v.x2) / 2;
    const baseY = v.y + 16;
    ctx.moveTo(v.x1, baseY);
    ctx.quadraticCurveTo(midX, baseY - VAULT_LIFT * 2, v.x2, baseY);
    ctx.stroke();
    ctx.restore();
  }
}

function drawBullets() {
  for (const b of game.bullets) {
    if (b.dead) continue;

    if (b.kind === 'icefire') {
      const g = ctx.createRadialGradient(b.x, b.y, 1, b.x, b.y, 16);
      g.addColorStop(0, '#f2fdff');
      g.addColorStop(0.38, '#7fe3ff');
      g.addColorStop(1, 'rgba(60, 180, 255, 0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(b.x, b.y, 16, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#ff8a3d';
      ctx.beginPath();
      ctx.arc(b.x, b.y, 6.5, 0, Math.PI * 2);
      ctx.fill();

      ctx.save();
      ctx.translate(b.x, b.y);
      ctx.rotate(game.time * 6);
      ctx.strokeStyle = 'rgba(235, 252, 255, 0.95)';
      ctx.lineWidth = 2;
      ctx.lineCap = 'round';
      for (let i = 0; i < 3; i++) {
        const a = (Math.PI / 3) * i;
        const dx = Math.cos(a) * 10;
        const dy = Math.sin(a) * 10;
        ctx.beginPath();
        ctx.moveTo(-dx, -dy);
        ctx.lineTo(dx, dy);
        ctx.stroke();
      }
      ctx.restore();
      continue;
    }

    if (b.kind === 'fire') {
      const g = ctx.createRadialGradient(b.x, b.y, 1, b.x, b.y, 13);
      g.addColorStop(0, '#fff3c4');
      g.addColorStop(1, 'rgba(255, 120, 40, 0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(b.x, b.y, 13, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#ff8a3d';
      ctx.beginPath();
      ctx.arc(b.x, b.y, 7, 0, Math.PI * 2);
      ctx.fill();
      continue;
    }

    if (b.isSnow) {
      ctx.fillStyle = '#8fd6ff';
      ctx.beginPath();
      ctx.arc(b.x, b.y, 6, 0, Math.PI * 2);
      ctx.fill();

      ctx.strokeStyle = 'rgba(230, 250, 255, 0.85)';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.arc(b.x, b.y, 8.2, 0, Math.PI * 2);
      ctx.stroke();
      continue;
    }

    ctx.fillStyle = '#a5e06a';
    ctx.beginPath();
    ctx.arc(b.x, b.y, 6, 0, Math.PI * 2);
    ctx.fill();
  }
}

function drawSuns() {
  for (const s of game.suns) {
    if (s.dead) continue;
    const pulse = 1 + Math.sin(game.time * 3) * 0.06;
    const r = 15 * pulse;
    const g = ctx.createRadialGradient(s.x, s.y, 2, s.x, s.y, r);
    g.addColorStop(0, '#fff9c4');
    g.addColorStop(1, '#f9a825');
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(s.x, s.y, r, 0, Math.PI * 2);
    ctx.fill();
  }
}

function drawFx() {
  for (const f of game.fx) {
    const k = 1 - f.t / f.life;
    ctx.globalAlpha = Math.max(0, 1 - k) * 0.8;

    if (f.fill) {
      ctx.fillStyle = f.color || '#ffb74d';
      ctx.beginPath();
      ctx.arc(f.x, f.y, Math.max(2, f.r * (1 - k * 0.55)), 0, Math.PI * 2);
      ctx.fill();
    } else {
      ctx.strokeStyle = f.color || '#ffb74d';
      ctx.lineWidth = f.r > 100 ? 5 : 3;
      ctx.beginPath();
      ctx.arc(f.x, f.y, Math.max(4, f.r * k), 0, Math.PI * 2);
      ctx.stroke();
    }

    ctx.globalAlpha = 1;
  }
}

function drawSurgeBanner() {
  if (game.surgePhase !== SURGE.BANNER) return;

  const total = ENDLESS.surgeBanner;
  const left = game.surgeTimer;
  const elapsed = total - left;

  let a = 1;
  if (elapsed < 0.35) a = elapsed / 0.35;
  if (left < 0.4) a = Math.min(a, left / 0.4);
  a = Math.max(0, Math.min(1, a));

  const cy = canvas.height / 2;
  const half = 48;

  ctx.save();
  ctx.globalAlpha = a;

  ctx.fillStyle = 'rgba(74, 10, 10, 0.78)';
  ctx.fillRect(0, cy - half, canvas.width, half * 2);

  ctx.fillStyle = 'rgba(255, 213, 79, 0.85)';
  ctx.fillRect(0, cy - half, canvas.width, 3);
  ctx.fillRect(0, cy + half - 3, canvas.width, 3);

  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillStyle = '#ffe082';
  ctx.font = '700 44px ' + CJK;
  ctx.fillText('一大波僵尸即将来袭', canvas.width / 2, cy - 2);

  ctx.restore();
}

function drawHover() {
  if (game.state !== STATE.PLAYING) return;
  if (!selected && !shovelMode) return;
  if (mouse.x < 0 || mouse.y < 0) return;

  const cell = game.cellAt(mouse.x, mouse.y);
  if (!cell) return;

  ctx.strokeStyle = shovelMode ? '#ff7043' : '#ffd54f';
  ctx.lineWidth = 3;
  ctx.strokeRect(cellX(cell.col) + 2, cellY(cell.row) + 2, CELL.w - 4, CELL.h - 4);
}

function render() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  drawField();
  drawPlants();
  drawBullets();
  drawZombies();
  drawVaultTrails();
  drawSuns();
  drawFx();
  drawHover();
  drawSurgeBanner();
}

function updateHud() {
  if (sunCountEl) sunCountEl.textContent = String(Math.floor(game.sun));
  syncCards();
}

function setSpeed(mul) {
  speedMul = mul === 2 ? 2 : 1;
  if (btnSpeed) {
    btnSpeed.textContent = speedMul + '×';
    btnSpeed.classList.toggle('on', speedMul === 2);
  }
}

function loop(ts) {
  requestAnimationFrame(loop);

  if (!lastTs) {
    lastTs = ts;
    return;
  }

  let dt = (ts - lastTs) / 1000;
  lastTs = ts;
  if (!(dt > 0)) return;
  if (dt > 0.05) dt = 0.05;

  const sdt = dt * speedMul;

  if (game.state === STATE.PLAYING || game.state === STATE.PAUSED) {
    if (game.state === STATE.PLAYING) {
      for (const z of game.zombies) {
        if (z.dead && z.dieT < z.dieDur) z.dieT += sdt;
      }
      game.update(sdt);
      trackCherryFx();
      updateHud();
    }

    saveAcc += dt;
    if (saveAcc >= SAVE_EVERY) {
      saveAcc = 0;
      saveGame();
    }
  }

  if (!endShown && game.state === STATE.LOST) {
    endShown = true;
    SFX.play('lose');
    clearSave();
    updateHud();
    showOverlay(
      '草坪失守',
      '撑到了第 ' + Math.max(1, game.waveIndex) + ' 波，击杀 ' + game.killed + ' 只。',
      '再来一次'
    );
  }

  render();
}

function startGame() {
  game.start();

  selected = null;
  shovelMode = false;
  endShown = false;
  lastTs = 0;
  saveAcc = 0;
  mouse.x = -999;
  mouse.y = -999;
  lastCherries = new Map();

  btnShovel.classList.remove('active');
  btnPause.textContent = '暂停';

  pauseMain.classList.remove('hidden-block');
  restartConfirm.classList.add('hidden-block');

  clearSave();
  hideOverlay();
  buildCards();
  updateHud();
  tip(TIP_DEFAULT);
}

function setEliteMode(mode) {
  eliteMode = (mode === 'all' || mode === 'none') ? mode : 'normal';
  for (const b of eliteSeg.children) {
    b.classList.toggle('on', b.dataset.mode === eliteMode);
  }
  saveSettings();
}

function syncSettingsUI() {
  volRange.value = String(Math.round(masterVolume * 100));
  volVal.textContent = Math.round(masterVolume * 100) + '%';
  for (const b of eliteSeg.children) {
    b.classList.toggle('on', b.dataset.mode === eliteMode);
  }
}

function bindEvents() {
  canvas.addEventListener('pointerdown', (ev) => {
    ev.preventDefault();
    const pt = toCanvas(ev);
    if (!pt) return;
    mouse.x = pt.x;
    mouse.y = pt.y;
    handlePointer(pt.x, pt.y);
  });

  canvas.addEventListener('pointermove', (ev) => {
    const pt = toCanvas(ev);
    if (!pt) return;
    if (ev.pointerType === 'mouse' || ev.buttons > 0) {
      mouse.x = pt.x;
      mouse.y = pt.y;
    }
  });

  canvas.addEventListener('pointerleave', () => { mouse.x = -999; mouse.y = -999; });
  canvas.addEventListener('pointerup', (ev) => {
    if (ev.pointerType === 'mouse') return;
    mouse.x = -999;
    mouse.y = -999;
  });
  canvas.addEventListener('pointercancel', () => { mouse.x = -999; mouse.y = -999; });

  btnShovel.addEventListener('click', () => {
    if (game.state !== STATE.PLAYING) return;
    SFX.play('shovel');
    toggleShovel(!shovelMode);
  });

  btnSpeed.addEventListener('click', () => setSpeed(speedMul === 1 ? 2 : 1));

  btnPause.addEventListener('click', () => {
    SFX.play('pause');

    if (game.state === STATE.PLAYING) {
      game.pause();
      btnPause.textContent = '继续';
      tip('已暂停');
      saveGame();
      showPausePanel();
    } else if (game.state === STATE.PAUSED) {
      game.resume();
      btnPause.textContent = '暂停';
      hideOverlay();
      tip(TIP_DEFAULT);
    }
  });

  menuStart.addEventListener('click', () => startGame());

  menuMini.addEventListener('click', () => {
    menuHint.textContent = '迷你游戏还在筹备，先玩主线吧。';
  });

  menuPuzzle.addEventListener('click', () => {
    menuHint.textContent = '解谜模式还在筹备，先玩主线吧。';
  });

  menuSurvive.addEventListener('click', () => {
    menuHint.textContent = '生存挑战还在筹备，先玩主线吧。';
  });

  overlayBtn.addEventListener('click', () => startGame());

  pauseResume.addEventListener('click', () => {
    if (game.state !== STATE.PAUSED) return;
    game.resume();
    btnPause.textContent = '暂停';
    hideOverlay();
    tip(TIP_DEFAULT);
  });

  pauseRestart.addEventListener('click', () => {
    pauseMain.classList.add('hidden-block');
    restartConfirm.classList.remove('hidden-block');
  });

  confirmNo.addEventListener('click', () => {
    restartConfirm.classList.add('hidden-block');
    pauseMain.classList.remove('hidden-block');
  });

  confirmYes.addEventListener('click', () => {
    restartConfirm.classList.add('hidden-block');
    pauseMain.classList.remove('hidden-block');
    startGame();
  });

  volRange.addEventListener('input', () => {
    masterVolume = Math.max(0, Math.min(1, volRange.value / 100));
    volVal.textContent = Math.round(masterVolume * 100) + '%';
    saveSettings();
  });

  eliteSeg.addEventListener('click', (ev) => {
    const btn = ev.target.closest('.seg-btn');
    if (!btn) return;
    setEliteMode(btn.dataset.mode);
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) saveGame();
  });
  window.addEventListener('pagehide', saveGame);
  window.addEventListener('beforeunload', saveGame);
}

