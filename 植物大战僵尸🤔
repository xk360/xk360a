function tip(text) {
  if (statusTip) statusTip.textContent = text;
}

function saveGame() {
  try {
    const data = game.serialize();
    if (!data) return;
    localStorage.setItem(SAVE_KEY, JSON.stringify(data));
  } catch (e) {}
}

function clearSave() {
  try { localStorage.removeItem(SAVE_KEY); } catch (e) {}
}

function loadGame() {
  try {
    const raw = localStorage.getItem(SAVE_KEY);
    if (!raw) return false;
    const d = JSON.parse(raw);
    if (!d || d.v < 1 || d.v > 6) return false;
    return game.hydrate(d) === true;
  } catch (e) {
    return false;
  }
}

function buildCards() {
  cardBar.innerHTML = '';
  for (const type of CARD_ORDER) {
    const def = PLANT_TYPES[type];

    const el = document.createElement('div');
    el.className = 'card';
    el.dataset.type = type;

    const ico = document.createElement('div');
    ico.className = 'c-ico';

    if (def.img) {
      const img = document.createElement('img');
      img.alt = '';
      img.decoding = 'async';
      img.draggable = false;
      img.addEventListener('error', function () {
        ico.textContent = def.icon;
      });
      img.src = def.img;
      ico.appendChild(img);
    } else {
      ico.textContent = def.icon;
    }

    const name = document.createElement('div');
    name.className = 'c-name';
    name.textContent = def.name;

    const cost = document.createElement('div');
    cost.className = 'c-cost';
    cost.textContent = '☀ ' + def.cost;

    const cd = document.createElement('div');
    cd.className = 'c-cd';

    el.appendChild(ico);
    el.appendChild(name);
    el.appendChild(cost);
    el.appendChild(cd);

    el.addEventListener('click', () => selectCard(type));
    cardBar.appendChild(el);
  }
}

function cardBlocked(type) {
  const def = PLANT_TYPES[type];
  if (!def) return true;
  if ((game.cooldowns[type] || 0) > 0) return true;
  return game.sun < def.cost;
}

function selectCard(type) {
  if (game.state !== STATE.PLAYING) return;

  if (cardBlocked(type)) {
    const def = PLANT_TYPES[type];
    const cd = game.cooldowns[type] || 0;
    if (cd > 0) tip(def.name + ' 冷却中，还要 ' + cd.toFixed(1) + ' 秒');
    else tip('阳光不足，还差 ' + (def.cost - game.sun));
    return;
  }

  SFX.play('select');

  if (shovelMode) toggleShovel(false);
  selected = selected === type ? null : type;
  syncCards();
  tip(selected ? '已选 ' + PLANT_TYPES[selected].name + '，点击草坪放置' : TIP_DEFAULT);
}

function syncCards() {
  for (const el of cardBar.children) {
    const type = el.dataset.type;
    const def = PLANT_TYPES[type];
    if (!def) continue;
    const cd = game.cooldowns[type] || 0;
    el.classList.toggle('selected', type === selected);
    el.classList.toggle('disabled', cd > 0 || game.sun < def.cost);
    const bar = el.querySelector('.c-cd');
    if (bar) {
      bar.style.height = cd > 0 ? Math.min(100, (cd / def.cd) * 100) + '%' : '0';
    }
  }
}

function toggleShovel(on) {
  if (game.state !== STATE.PLAYING) return;
  shovelMode = !!on;
  btnShovel.classList.toggle('active', shovelMode);
  if (shovelMode) {
    selected = null;
    syncCards();
  }
  tip(shovelMode ? '铲子模式：点击植物移除' : TIP_DEFAULT);
}

