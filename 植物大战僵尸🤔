/* ==================================================================
   音频本地缓存：Cache API 主存，IndexedDB 备存
   ================================================================== */
const AUDIO_CACHE_NAME = 'lawn-audio-cache-v2';
const AUDIO_BLOB = Object.create(null);

const IDB_NAME = 'lawn-audio-db';
const IDB_STORE = 'audio';
let _idbPromise = null;

function audioSrc(key) {
  return AUDIO_BLOB[key] || SFX_SRC[key] || '';
}

function hasCacheApi() {
  return typeof caches !== 'undefined' && caches && typeof caches.open === 'function';
}

function hasIDB() {
  return typeof indexedDB !== 'undefined' && indexedDB !== null;
}

function idbOpen() {
  if (_idbPromise) return _idbPromise;

  _idbPromise = new Promise(function (resolve, reject) {
    if (!hasIDB()) {
      reject(new Error('no idb'));
      return;
    }
    let req;
    try {
      req = indexedDB.open(IDB_NAME, 1);
    } catch (e) {
      reject(e);
      return;
    }
    req.onupgradeneeded = function () {
      const db = req.result;
      if (!db.objectStoreNames.contains(IDB_STORE)) db.createObjectStore(IDB_STORE);
    };
    req.onsuccess = function () { resolve(req.result); };
    req.onerror = function () { reject(req.error || new Error('idb open')); };
    req.onblocked = function () { reject(new Error('idb blocked')); };
  });

  _idbPromise.catch(function () { _idbPromise = null; });
  return _idbPromise;
}

function idbGet(key) {
  return idbOpen().then(function (db) {
    return new Promise(function (resolve, reject) {
      let tx;
      try {
        tx = db.transaction(IDB_STORE, 'readonly');
      } catch (e) {
        reject(e);
        return;
      }
      const req = tx.objectStore(IDB_STORE).get(key);
      req.onsuccess = function () { resolve(req.result || null); };
      req.onerror = function () { reject(req.error); };
    });
  });
}

function idbSet(key, value) {
  return idbOpen().then(function (db) {
    return new Promise(function (resolve, reject) {
      let tx;
      try {
        tx = db.transaction(IDB_STORE, 'readwrite');
      } catch (e) {
        reject(e);
        return;
      }
      const req = tx.objectStore(IDB_STORE).put(value, key);
      req.onsuccess = function () { resolve(true); };
      req.onerror = function () { reject(req.error); };
    });
  });
}

async function readStored(key) {
  const url = SFX_SRC[key];

  if (hasCacheApi()) {
    try {
      const cache = await caches.open(AUDIO_CACHE_NAME);
      const res = await cache.match(url);
      if (res) {
        const blob = await res.blob();
        if (blob && blob.size > 0) return blob;
      }
    } catch (e) {}
  }

  if (hasIDB()) {
    try {
      const rec = await idbGet(url);
      if (rec && rec.buf && rec.buf.byteLength > 0) {
        return new Blob([rec.buf], { type: rec.type || 'audio/mpeg' });
      }
    } catch (e) {}
  }

  return null;
}

async function writeStored(key, res) {
  const url = SFX_SRC[key];

  if (hasCacheApi()) {
    try {
      const cache = await caches.open(AUDIO_CACHE_NAME);
      try { await cache.put(url, res.clone()); } catch (e) {}
    } catch (e) {}
  }

  if (hasIDB()) {
    try {
      const buf = await res.clone().arrayBuffer();
      if (buf && buf.byteLength > 0) {
        let type = 'audio/mpeg';
        try { type = res.headers.get('content-type') || type; } catch (e) {}
        await idbSet(url, { buf: buf, type: type });
      }
    } catch (e) {}
  }
}

async function primeAudioCache() {
  const keys = Object.keys(SFX_SRC);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    if (AUDIO_BLOB[key]) continue;
    try {
      const blob = await readStored(key);
      if (blob && blob.size > 0) AUDIO_BLOB[key] = URL.createObjectURL(blob);
    } catch (e) {}
  }
}

async function warmAudioCache() {
  const keys = Object.keys(SFX_SRC);
  let changed = false;

  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    if (AUDIO_BLOB[key]) continue;

    const url = SFX_SRC[key];
    try {
      const res = await fetch(url, { mode: 'cors', credentials: 'omit' });
      if (!res || !res.ok) continue;

      try {
        const blob = await res.clone().blob();
        if (blob && blob.size > 0) {
          AUDIO_BLOB[key] = URL.createObjectURL(blob);
          changed = true;
        }
      } catch (e) {}

      await writeStored(key, res);
    } catch (e) {}
  }

  if (changed) SFX.refresh();
}

const SFX = {
  pools: Object.create(null),
  cursor: Object.create(null),
  temp: [],
  status: Object.create(null),
  queue: [],
  active: 0,
  thiefCursor: 0,
  thiefLast: '',
  firePeaLast: '',
  coneHitLast: '',
  unlocked: false,
  ready: false,

  make(key) {
    const a = new Audio();
    a.preload = 'none';
    a.volume = typeof SFX_VOLUME[key] === 'number' ? SFX_VOLUME[key] : 0.5;
    return a;
  },

  init() {
    if (this.ready) return;
    this.ready = true;

    const keys = Object.keys(SFX_SRC);
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i];
      const size = SFX_POOL_OVERRIDE[key] || SFX_POOL_SIZE;
      const list = [];
      for (let k = 0; k < size; k++) list.push(this.make(key));
      this.pools[key] = list;
      this.cursor[key] = 0;
      this.status[key] = 'idle';
    }

    const rest = keys.filter(function (k) {
      return SFX_PRIORITY.indexOf(k) < 0;
    });
    const head = SFX_PRIORITY.filter(function (k) {
      return !!SFX_SRC[k];
    });

    this.queue = head.concat(rest);
    this.pump();
  },

  pump() {
    while (this.active < SFX_LOAD_CONCURRENCY && this.queue.length > 0) {
      const key = this.queue.shift();
      if (this.status[key] !== 'idle') continue;
      this.startLoad(key);
    }
  },

  startLoad(key) {
    const list = this.pools[key];
    if (!list || !list.length) return;

    this.status[key] = 'loading';
    this.active++;

    const a = list[0];
    const self = this;
    let settled = false;
    let timer = 0;

    const finish = function (ok) {
      if (settled) return;
      settled = true;

      if (timer) clearTimeout(timer);

      self.active--;
      self.status[key] = ok ? 'ready' : 'fail';

      if (ok) {
        for (let i = 1; i < list.length; i++) {
          try { list[i].src = audioSrc(key); } catch (e) {}
        }
        if (self.unlocked) self.prime(key);
      }

      self.pump();
    };

    timer = setTimeout(function () {
      finish(a.readyState >= 2);
    }, SFX_LOAD_TIMEOUT);

    a.addEventListener('loadeddata', function () { finish(true); }, { once: true });
    a.addEventListener('canplaythrough', function () { finish(true); }, { once: true });
    a.addEventListener('error', function () { finish(false); }, { once: true });

    a.preload = 'auto';

    try {
      a.src = audioSrc(key);
    } catch (e) {
      finish(false);
    }
  },

  prime(key) {
    const list = this.pools[key];
    if (!list || !list.length) return;
    const a = list[0];

    try {
      a.muted = true;

      const done = function () {
        try {
          a.pause();
          a.currentTime = 0;
        } catch (e) {}
        a.muted = false;
      };

      const p = a.play();
      if (p && typeof p.then === 'function') p.then(done).catch(done);
      else done();
    } catch (e) {
      a.muted = false;
    }
  },

  refresh() {
    if (!this.ready) return;
    const keys = Object.keys(this.pools);

    for (let i = 0; i < keys.length; i++) {
      const k = keys[i];
      if (this.status[k] === 'fail') this.status[k] = 'idle';
    }

    for (let i = 0; i < keys.length; i++) {
      const k = keys[i];
      if (this.status[k] === 'idle' && this.queue.indexOf(k) < 0) {
        this.queue.push(k);
      }
    }

    this.pump();
  },

  freeOne(key) {
    if (this.status[key] !== 'ready') return null;

    const list = this.pools[key];
    if (!list || !list.length) return null;

    const start = this.cursor[key] || 0;

    for (let i = 0; i < list.length; i++) {
      const idx = (start + i) % list.length;
      const a = list[idx];
      if (a.paused || a.ended) {
        this.cursor[key] = (idx + 1) % list.length;
        if (!a.src) {
          try { a.src = audioSrc(key); } catch (e) {}
        }
        return a;
      }
    }

    const extra = this.make(key);
    try {
      extra.src = audioSrc(key);
    } catch (e) {
      return null;
    }

    const self = this;
    extra.addEventListener('ended', function () {
      const i = self.temp.indexOf(extra);
      if (i >= 0) self.temp.splice(i, 1);
    });

    this.temp.push(extra);
    return extra;
  },

  fire(a, key) {
    if (!a) return;

    const base = typeof SFX_VOLUME[key] === 'number' ? SFX_VOLUME[key] : 0.5;

    try {
      a.volume = Math.max(0, Math.min(1, base * masterVolume));
      a.currentTime = 0;
    } catch (e) {}

    try {
      const p = a.play();
      if (p && typeof p.catch === 'function') p.catch(function () {});
    } catch (e) {}
  },

  readyKeys(keys) {
    const out = [];
    for (let i = 0; i < keys.length; i++) {
      if (this.status[keys[i]] === 'ready') out.push(keys[i]);
    }
    return out;
  },

  play(key) {
    if (!SFX_SRC[key]) return;
    this.init();

    if (this.status[key] === 'fail') {
      this.status[key] = 'idle';
      this.queue.push(key);
      this.pump();
      return;
    }

    this.fire(this.freeOne(key), key);
  },

  playThief() {
    this.init();

    const keys = this.readyKeys(THIEF_SFX_KEYS);
    if (!keys.length) return;

    const n = keys.length;
    let i = this.thiefCursor % n;
    if (keys[i] === this.thiefLast) i = (i + 1) % n;

    this.thiefCursor = i + 1;
    this.thiefLast = keys[i];

    this.fire(this.freeOne(keys[i]), keys[i]);
  },

  playBite() {
    this.init();

    const keys = this.readyKeys(BITE_SFX_KEYS);
    if (!keys.length) return;

    const key = keys[Math.floor(Math.random() * keys.length)];
    this.fire(this.freeOne(key), key);
  },

  playIdle(exclude) {
    this.init();

    const keys = this.readyKeys(IDLE_SFX_KEYS);
    if (!keys.length) return exclude;

    const cands = [];
    for (let i = 0; i < keys.length; i++) {
      if (keys[i] !== exclude) cands.push(keys[i]);
    }

    const pool = cands.length ? cands : keys;
    const key = pool[Math.floor(Math.random() * pool.length)];

    this.fire(this.freeOne(key), key);
    return key;
  },

  playFirePea() {
    this.init();

    const keys = this.readyKeys(FIREPEA_SFX_KEYS);
    if (!keys.length) return;

    let key = keys[Math.floor(Math.random() * keys.length)];
    if (keys.length > 1 && key === this.firePeaLast) {
      key = keys[(keys.indexOf(key) + 1) % keys.length];
    }

    this.firePeaLast = key;
    this.fire(this.freeOne(key), key);
  },

  playHitCone() {
    this.init();

    const keys = this.readyKeys(CONEHIT_SFX_KEYS);
    if (!keys.length) return;

    let key = keys[Math.floor(Math.random() * keys.length)];
    if (keys.length > 1 && key === this.coneHitLast) {
      key = keys[(keys.indexOf(key) + 1) % keys.length];
    }

    this.coneHitLast = key;
    this.fire(this.freeOne(key), key);
  },

  playBodyHit() {
    this.init();

    const keys = this.readyKeys(BODYHIT_SFX_KEYS);
    if (!keys.length) return;

    const key = keys[Math.floor(Math.random() * keys.length)];
    this.fire(this.freeOne(key), key);
  },

  playBuild() {
    this.init();

    const keys = this.readyKeys(BUILD_SFX_KEYS);
    if (!keys.length) return;

    const key = keys[Math.floor(Math.random() * keys.length)];
    this.fire(this.freeOne(key), key);
  },

  unlock() {
    this.init();

    if (this.unlocked) return;
    this.unlocked = true;

    const keys = Object.keys(this.pools);

    for (let i = 0; i < keys.length; i++) {
      if (this.status[keys[i]] === 'ready') {
        this.prime(keys[i]);
        break;
      }
    }
  }
};

/* ==================================================================
   实体
   ================================================================== */
const BULLET_SPEED = 420;
const DEFAULT_FUSE = 0.9;
const VAULT_DUR = 0.45;
const VAULT_LIFT = 44;
const DIE_DUR = 0.65;
const EMERGE_DUR = 1;
const BITE_DUR = 1;
const SUN_PULSE = 0.4;
const SHOOT_FLASH = 0.16;
const GARLIC_INTERVAL = 10;
const LANE_SHIFT_DUR = 0.7;
const CHERRY_MINE_CHANCE = 0.1;

const HEAL_INTERVAL = 3;
const HEAL_AMOUNT = 300;
const HEAL_CELL = 1;

const GOLD_SHIELD_DUR = 10;
const GOLD_SPEED_MUL = 3;

const FLAG_AURA_SPEED = 5;
const SUN_DRAIN_TICK = 1;

const BUFFED_HEAD = '#c2453a';

const TRACKSUIT_RED = '#e02f2f';

const THIEF_HEIGHT = 340;
const DROP_FALL = 2;
const STEAL_FALL = DROP_FALL;
const THIEF_MARK = 0.2;
const THIEF_HOVER = 5;
const THIEF_LEAVE = 1.2;
const HOVER_LIFT = 44;

const ATTACK_REACH = 0;

const CHOMP_REACH = CELL.w * 2;

let _uid = 1;
function uid() { return _uid++; }

function cellX(col) { return FIELD.x + col * CELL.w; }
function cellY(row) { return FIELD.y + row * CELL.h; }
function centerX(col) { return cellX(col) + CELL.w / 2; }
function centerY(row) { return cellY(row) + CELL.h / 2; }
function colOfX(px) { return Math.floor((px - FIELD.x) / CELL.w); }

function walkSpeed(z) { return z.speed + (z.speedBoost || 0); }

class Plant {
  constructor(type, col, row) {
    const def = PLANT_TYPES[type];
    if (!def) throw new Error('未知植物类型：' + type);

    this.id = uid();
    this.type = type;
    this.def = def;
    this.col = col;
    this.row = row;
    this.hp = def.hp;
    this.maxHp = def.hp;
    this.dead = false;
    this.abducted = false;
    this.fireTimer = 0;
    this.sunTimer = 0;

    this.fuseTimer = def.fuse !== undefined ? def.fuse : DEFAULT_FUSE;
    this.armed = type === 'cherry';
    this.exploded = false;

    this.digest = 0;
    this.biteT = 0;
    this.biteTarget = null;

    this.armTimer = def.armTime || 0;
    this.emergeT = (type === 'potatomine' && this.armTimer <= 0) ? EMERGE_DUR : 0;

    this.flashT = 0;
    this.pulseT = 0;
  }

  get x() { return centerX(this.col); }
  get y() { return centerY(this.row); }
  get radius() { return this.def.radius || 0; }

  hurt(dmg) {
    if (this.dead || this.abducted) return;
    if (this.type === 'potatomine' && this.emergeT > 0) return;

    this.hp -= dmg;
    if (this.hp <= 0) {
      this.hp = 0;
      this.dead = true;
    }
  }

  tickFuse(dt) {
    if (!this.armed || this.exploded) return false;
    this.fuseTimer -= dt;
    if (this.fuseTimer > 0) return false;
    this.exploded = true;
    this.dead = true;
    return true;
  }

  get hpRatio() {
    return this.maxHp > 0 ? this.hp / this.maxHp : 0;
  }
}

class Zombie {
  constructor(type, row, x) {
    const def = ZOMBIE_TYPES[type];
    if (!def) throw new Error('未知僵尸类型：' + type);

    this.id = uid();
    this.type = type;
    this.def = def;
    this.row = row;
    this.x = x;
    this.hp = def.hp;
    this.armor = def.armor;
    this.armor2 = def.armor2 || 0;
    this.speed = def.speed;
    this.speedBoost = 0;
    this.slowTimer = 0;
    this.eatTimer = 0;
    this.eating = false;
    this.dead = false;
    this.walkPhase = Math.random() * Math.PI * 2;

    this.vaulted = false;
    this.skipPlantId = 0;
    this.jumpT = 0;
    this.jumpDur = 0;
    this.jumpFrom = 0;
    this.jumpTo = 0;
    this.jumpLift = 0;

    this.shiftT = 0;
    this.shiftDur = 0;
    this.shiftDir = 0;
    this.shiftY = 0;
    this.garlicTimer = GARLIC_INTERVAL;
    this.biteFlash = 0;

    this.slowSfxDone = false;

    this.idleLast = '';
    this.idleTimer = IDLE_GAP_MIN + Math.random() * (IDLE_GAP_MAX - IDLE_GAP_MIN);

    this.enraged = false;
    this.roadBuffed = false;

    this.poleLeft = def.poleTier || 0;
    this.jumpIndex = 0;
    this.jumped = 0;
    this.friendly = false;

    this.healTimer = HEAL_INTERVAL;
    this.deathDone = false;

    this.thiefStage = '';
    this.thiefT = 0;
    this.dropLift = 0;
    this.carryType = '';
    this.targetPlantId = 0;
    this.targetX = 0;
    this.targetY = 0;
    this.targetRow = 0;
    this.targetPlantType = '';
    this.stolen = false;

    this.goldRaged = false;
    this.goldShieldT = 0;

    this.dieT = 0;
    this.dieDur = DIE_DUR;
    this.counted = false;
  }

  get y() { return centerY(this.row) + this.shiftY; }
  get hpTotal() { return this.hp + this.armor + this.armor2; }

  get hasPole() { return this.poleLeft > 0; }

  get isPole() { return !!this.def.poleTier; }

  get airborne() {
    return this.jumpDur > 0 && this.jumpT < this.jumpDur;
  }

  get shifting() {
    return this.shiftT > 0;
  }

  get invulnerable() {
    if (this.def.thief) {
      if (this.def.thief === 'drop') return true;
      return this.thiefStage !== 'hover';
    }
    return this.airborne || this.shifting;
  }

  /* 直线攻击：铁门 → 一类防具 → 本体，逐层吸收，都不溢出 */
  hurt(dmg) {
    if (this.dead) return;
    if (this.def.thief && this.invulnerable) return;
    if (this.goldShieldT > 0) return;

    if (this.armor2 > 0) {
      this.armor2 -= dmg;
      if (this.armor2 < 0) this.armor2 = 0;
      return;
    }

    if (this.armor > 0) {
      this.armor -= dmg;
      if (this.armor < 0) this.armor = 0;
      return;
    }

    this.hp -= dmg;
    if (this.hp <= 0) {
      this.hp = 0;
      this.dead = true;
      this.dieT = 0;
    }
  }

  hurtPierce(dmg) {
    if (this.dead) return;
    if (this.def.thief && this.invulnerable) return;
    if (this.goldShieldT > 0) return;

    this.hp -= dmg;
    if (this.hp <= 0) {
      this.hp = 0;
      this.dead = true;
      this.dieT = 0;
    }
  }

  kill() {
    if (this.dead) return;
    this.armor = 0;
    this.armor2 = 0;
    this.hp = 0;
    this.dead = true;
    this.dieT = 0;
  }

  get hpRatio() {
    const total = this.def.hp + this.def.armor + (this.def.armor2 || 0);
    return total > 0 ? this.hpTotal / total : 0;
  }
}

class Bullet {
  constructor(x, y, row, damage, slow, isSnow, kind, splash) {
    this.id = uid();
    this.x = x;
    this.y = y;
    this.row = row;
    this.damage = damage;
    this.slow = slow || 0;
    this.isSnow = !!isSnow;
    this.kind = kind || 'pea';
    this.splash = splash || 0;
    this.speed = BULLET_SPEED;
    this.dead = false;
  }
}

class SunToken {
  constructor(x, y, targetY, value) {
    this.id = uid();
    this.x = x;
    this.y = y;
    this.targetY = targetY;
    this.value = value;
    this.life = SUN_LIFE;
    this.dead = false;
    this.collected = false;
  }

  collect() {
    this.dead = true;
    this.collected = true;
  }
}

/* ==================================================================
   逻辑
   ================================================================== */
const STATE = { IDLE: 'idle', PLAYING: 'playing', PAUSED: 'paused', LOST: 'lost' };
const SURGE = { NONE: 'none', BANNER: 'banner' };

const MAX_DT = 0.1;
const BULLET_SUBSTEP = 12;
const BULLET_HIT_RANGE = 26;
const EAT_TICK = 0.5;

class Game {
  constructor() {
    this.reset();
  }

  reset() {
    this.sun = SUN_START;
    this.plants = [];
    this.zombies = [];
    this.bullets = [];
    this.suns = [];
    this.fx = [];
    this.vaultTrails = [];
    this.grid = [];

    for (let r = 0; r < GRID.rows; r++) {
      this.grid.push(new Array(GRID.cols).fill(null));
    }

    this.time = 0;
    this.sunTimer = 0;
    this.sunDrainAcc = 0;
    this.waveIndex = 0;
    this.waveTimer = ENDLESS.firstDelay;
    this.pending = [];
    this.state = STATE.IDLE;

    this.surgePhase = SURGE.NONE;
    this.surgeTimer = 0;
    this.surgeText = '';

    this.cooldowns = {};
    for (const k of Object.keys(PLANT_TYPES)) {
      this.cooldowns[k] = 0;
    }

    this.killed = 0;

    this.firstZombieSfx = false;
  }

  start() {
    this.reset();
    this.state = STATE.PLAYING;
    return true;
  }

  pause() {
    if (this.state !== STATE.PLAYING) return false;
    this.state = STATE.PAUSED;
    return true;
  }

  resume() {
    if (this.state !== STATE.PAUSED) return false;
    this.state = STATE.PLAYING;
    return true;
  }

  get over() { return this.state === STATE.LOST; }

  inBounds(col, row) {
    return Number.isInteger(col) && Number.isInteger(row)
      && col >= 0 && col < GRID.cols
      && row >= 0 && row < GRID.rows;
  }

  cellAt(px, py) {
    const col = colOfX(px);
    const row = Math.floor((py - FIELD.y) / CELL.h);
    if (!this.inBounds(col, row)) return null;
    return { col, row };
  }

  plantById(id) {
    for (const p of this.plants) {
      if (p.id === id) return p;
    }
    return null;
  }

  addZombie(z) {
    this.zombies.push(z);

    if (!this.firstZombieSfx) {
      this.firstZombieSfx = true;
      SFX.play('zombie');
    }

    return z;
  }

  canPlace(type, col, row) {
    if (this.state !== STATE.PLAYING) return false;
    if (!this.inBounds(col, row)) return false;
    const def = PLANT_TYPES[type];
    if (!def) return false;
    if (this.grid[row][col]) return false;
    if (this.sun < def.cost) return false;
    return this.cooldowns[type] <= 0;
  }

  place(type, col, row) {
    if (!this.canPlace(type, col, row)) return false;
    const def = PLANT_TYPES[type];

    this.sun -= def.cost;
    this.cooldowns[type] = def.cd;

    const p = new Plant(type, col, row);
    this.grid[row][col] = p;
    this.plants.push(p);

    SFX.playBuild();
    if (type === 'cherry') SFX.play('cherryfuse');
    return true;
  }

  removeAt(col, row) {
    if (this.state !== STATE.PLAYING) return false;
    if (!this.inBounds(col, row)) return false;
    const p = this.grid[row][col];
    if (!p || p.abducted) return false;
    p.dead = true;
    this.grid[row][col] = null;

    SFX.playBuild();
    return true;
  }

  explodeCherry(p) {
    SFX.play('cherry');

    const r = p.radius;
    const dmg = p.def.damage;

    for (const z of this.zombies) {
      if (z.dead || z.def.thief || z.friendly) continue;
      if (Math.abs(z.row - p.row) > 1) continue;
      if (Math.abs(z.x - p.x) <= r) z.hurtPierce(dmg);
    }

    p.dead = true;
    if (this.inBounds(p.col, p.row) && this.grid[p.row][p.col] === p) {
      this.grid[p.row][p.col] = null;
    }

    if (Math.random() < CHERRY_MINE_CHANCE) {
      if (this.inBounds(p.col, p.row) && !this.grid[p.row][p.col]) {
        const mine = new Plant('potatomine', p.col, p.row);
        this.grid[p.row][p.col] = mine;
        this.plants.push(mine);
      }
    }
  }

  update(rawDt) {
    if (this.state !== STATE.PLAYING) return;

    let dt = Number(rawDt);
    if (!(dt > 0)) return;
    if (dt > MAX_DT) dt = MAX_DT;

    this.time += dt;

    for (const k of Object.keys(this.cooldowns)) {
      if (this.cooldowns[k] > 0) {
        this.cooldowns[k] = Math.max(0, this.cooldowns[k] - dt);
      }
    }

    this.spawnSkySun(dt);
    this.updatePlants(dt);
    this.updateBullets(dt);
    this.updateZombies(dt);
    if (this.state !== STATE.PLAYING) return;
    this.updateWaves(dt);
    this.updateSuns(dt);
    this.updateFx(dt);
    this.updateTrails(dt);
    this.cleanup();
  }

  spawnSkySun(dt) {
    this.sunTimer += dt;
    if (this.sunTimer < SUN_FALL_INTERVAL) return;
    this.sunTimer -= SUN_FALL_INTERVAL;

    const x = FIELD.x + 40 + Math.random() * (FIELD.w - 80);
    const y = FIELD.y - 20;
    const ty = FIELD.y + 40 + Math.random() * (FIELD.h - 140);
    this.suns.push(new SunToken(x, y, ty, SUN_VALUE));
  }

  updatePlants(dt) {
    for (const p of this.plants) {
      if (p.dead || p.abducted) continue;

      if (p.flashT > 0) p.flashT = Math.max(0, p.flashT - dt);
      if (p.pulseT > 0) p.pulseT = Math.max(0, p.pulseT - dt);

      if (p.type === 'cherry') {
        if (p.tickFuse(dt)) this.explodeCherry(p);
        continue;
      }

      if (p.type === 'potatomine') {
        if (p.armTimer > 0) {
          p.armTimer -= dt;
          if (p.armTimer <= 0) {
            p.armTimer = 0;
            p.emergeT = EMERGE_DUR;
          }
          continue;
        }

        if (p.emergeT > 0) {
          p.emergeT = Math.max(0, p.emergeT - dt);
          continue;
        }

        const left = cellX(p.col);
        const right = left + CELL.w;
        let trigger = false;

        for (const z of this.zombies) {
          if (z.dead || z.friendly || z.row !== p.row || z.invulnerable) continue;
          if (z.x >= left && z.x <= right) { trigger = true; break; }
        }

        if (!trigger) continue;

        const r = p.def.radius;
        const cx = p.x;

        for (const z of this.zombies) {
          if (z.dead || z.friendly || z.row !== p.row || z.invulnerable) continue;
          if (Math.abs(z.x - cx) <= r) z.hurtPierce(p.def.damage);
        }

        SFX.play('mineboom');

        this.fx.push({ x: cx, y: p.y, r: r, t: 0.5, life: 0.5 });
        p.dead = true;
        if (this.grid[p.row][p.col] === p) this.grid[p.row][p.col] = null;
        continue;
      }

      if (p.type === 'chomper') {
        if (p.biteT > 0) {
          p.biteT -= dt;
          if (p.biteT <= 0) {
            p.biteT = 0;
            const t = p.biteTarget;
            p.biteTarget = null;
            if (t && !t.dead) {
              t.kill();
              p.digest = p.def.digest;
            }
          }
          continue;
        }

        if (p.digest > 0) {
          p.digest = Math.max(0, p.digest - dt);
          continue;
        }

        const cx = p.x;
        const reach = cx + CHOMP_REACH;
        let prey = null;

        for (const z of this.zombies) {
          if (z.dead || z.friendly || z.row !== p.row) continue;
          if (z.invulnerable || z.def.ignorePlants) continue;
          if (z.x < cx - 10) continue;
          if (z.x > reach) continue;
          if (!prey || z.x < prey.x) prey = z;
        }

        if (prey) {
          p.biteT = BITE_DUR;
          p.biteTarget = prey;
          SFX.play('chomper');
        }
        continue;
      }

      if (p.type === 'sunflower') {
        p.sunTimer += dt;
        if (p.sunTimer >= p.def.sunRate) {
          p.sunTimer -= p.def.sunRate;
          p.pulseT = SUN_PULSE;
          this.suns.push(new SunToken(
            p.x + (Math.random() * 20 - 10),
            p.y - 10,
            p.y + 10,
            SUN_VALUE
          ));
        }
        continue;
      }

      if (p.type === 'peashooter' || p.type === 'snowpea' || p.type === 'repeater') {
        const hasTarget = this.zombies.some(
          (z) => !z.dead && !z.friendly && (!z.def.thief || !z.invulnerable)
            && z.row === p.row && z.x > p.x - 20
        );

        if (!hasTarget) {
          p.fireTimer = Math.min(p.fireTimer + dt, p.def.fireRate);
          continue;
        }

        p.fireTimer += dt;
        if (p.fireTimer >= p.def.fireRate) {
          p.fireTimer -= p.def.fireRate;
          this.fireBullet(p);
        }
      }
    }
  }

  fireBullet(p) {
    const isSnow = p.type === 'snowpea';
    const chance = p.def.fireChance || 0;
    const shots = p.def.shots || 1;
    const slow = isSnow ? p.def.slow : 0;
    const y = p.y - 8;

    p.flashT = SHOOT_FLASH;

    this.fx.push({
      x: p.x + 26, y: y, r: 13, t: 0.14, life: 0.14,
      color: isSnow ? '#bfefff' : '#d8ffa8', fill: true
    });

    for (let i = 0; i < shots; i++) {
      const x = p.x + 22 - i * SHOT_OFFSET;
      const fire = Math.random() < chance;

      if (fire) {
        const kind = isSnow ? 'icefire' : 'fire';
        this.bullets.push(new Bullet(
          x, y, p.row,
          p.def.damage * (p.def.fireMul || 2),
          slow, isSnow, kind,
          p.def.damage
        ));
      } else {
        this.bullets.push(new Bullet(
          x, y, p.row,
          p.def.damage, slow, isSnow, 'pea', 0
        ));
      }
    }
  }

  armorLayer(z) {
    if (z.def.thief) return 'body';

    if (z.armor2 > 0) return 'door';

    if (z.armor > 0) {
      const kind = z.def.hatKind || (z.type === 'bucket' ? 'bucket' : 'cone');
      return kind === 'bucket' ? 'bucket' : 'cone';
    }

    return 'body';
  }

  playArmorSfx(z) {
    const layer = this.armorLayer(z);

    if (layer === 'cone') {
      SFX.playHitCone();
      return;
    }

    if (layer === 'bucket') {
      SFX.play('buckethit');
      return;
    }

    if (layer === 'door') {
      SFX.play('doorhit');
      return;
    }

    SFX.playBodyHit();
  }

  updateBullets(dt) {
    const splashR = CELL.w * SPLASH_CELLS;

    for (const b of this.bullets) {
      if (b.dead) continue;

      const total = b.speed * dt;
      const steps = Math.max(1, Math.ceil(total / BULLET_SUBSTEP));
      const step = total / steps;

      for (let s = 0; s < steps; s++) {
        b.x += step;

        if (b.x > FIELD.x + FIELD.w + 20) {
          b.dead = true;
          break;
        }

        let hit = null;
        for (const z of this.zombies) {
          if (z.dead || z.friendly || z.row !== b.row) continue;
          if (z.invulnerable) continue;
          if (Math.abs(z.x - b.x) >= BULLET_HIT_RANGE) continue;
          if (!hit || z.x < hit.x) hit = z;
        }

        if (!hit) continue;

        const hx = hit.x;
        const isFireBullet = b.kind === 'fire' || b.kind === 'icefire';

        if (isFireBullet) {
          SFX.playFirePea();
        } else {
          this.playArmorSfx(hit);
        }

        hit.hurt(b.damage);
        if (b.slow > 0 && !hit.dead) {
          hit.slowTimer = Math.max(hit.slowTimer, b.slow);
          if (!hit.slowSfxDone) {
            hit.slowSfxDone = true;
            SFX.play('frost');
          }
        }

        if (b.splash > 0) {
          for (const z of this.zombies) {
            if (z === hit || z.dead || z.friendly || z.row !== b.row) continue;
            if (z.invulnerable) continue;
            if (Math.abs(z.x - hx) > splashR) continue;
            z.hurt(b.splash);
            if (b.slow > 0 && !z.dead) {
              z.slowTimer = Math.max(z.slowTimer, b.slow);
              if (!z.slowSfxDone) {
                z.slowSfxDone = true;
                SFX.play('frost');
              }
            }
          }

          this.fx.push({
            x: hx, y: b.y, r: splashR, t: 0.26, life: 0.26,
            color: b.kind === 'icefire' ? '#4fc3f7' : '#ff8a3d'
          });
        }

        b.dead = true;
        break;
      }
    }
  }

  startLaneShift(z) {
    const opts = [];
    if (z.row - 1 >= 0) opts.push(z.row - 1);
    if (z.row + 1 < GRID.rows) opts.push(z.row + 1);
    if (!opts.length) return false;

    const target = opts[Math.floor(Math.random() * opts.length)];
    const dir = target - z.row;

    z.shiftDur = LANE_SHIFT_DUR;
    z.shiftT = LANE_SHIFT_DUR;
    z.shiftDir = dir;
    z.shiftY = -dir * CELL.h;
    z.row = target;
    z.eating = false;
    z.eatTimer = 0;
    z.biteFlash = GARLIC_INTERVAL;
    return true;
  }

  healAround(src) {
    const budget = src.def.healAmount || HEAL_AMOUNT;

    const srcCol = colOfX(src.x);
    const srcRow = src.row;

    for (const z of this.zombies) {
      if (z.dead || z.def.thief) continue;
      if (Math.abs(z.row - srcRow) > HEAL_CELL) continue;

      const zc = colOfX(z.x);
      if (Math.abs(zc - srcCol) > HEAL_CELL) continue;

      let left = budget;
      let healed = 0;

      const maxHp = z.def.hp;
      if (z.hp < maxHp) {
        const add = Math.min(left, maxHp - z.hp);
        z.hp += add;
        healed += add;
        left -= add;
      }

      const maxArmor = z.def.armor || 0;
      if (left > 0 && z.armor > 0 && z.armor < maxArmor) {
        const add = Math.min(left, maxArmor - z.armor);
        z.armor += add;
        healed += add;
        left -= add;
      }

      const maxArmor2 = z.def.armor2 || 0;
      if (left > 0 && z.armor2 > 0 && z.armor2 < maxArmor2) {
        const add = Math.min(left, maxArmor2 - z.armor2);
        z.armor2 += add;
        healed += add;
        left -= add;
      }

      if (healed <= 0) continue;

      this.fx.push({
        x: z.x, y: z.y - 6, r: 22, t: 0.5, life: 0.5,
        color: '#7ee08a'
      });
    }
  }

  applyFlagAura(dt) {
    let hasAura = false;
    let drain = 0;

    for (const z of this.zombies) {
      if (z.dead) continue;
      if (z.def.flagAura) hasAura = true;
      if (z.def.sunDrain) drain += z.def.sunDrain;
    }

    if (hasAura) {
      for (const z of this.zombies) {
        if (z.dead || z.roadBuffed) continue;
        z.roadBuffed = true;
        z.speedBoost += FLAG_AURA_SPEED;
      }
    }

    if (drain > 0) {
      this.sunDrainAcc += dt;
      if (this.sunDrainAcc >= SUN_DRAIN_TICK) {
        const ticks = Math.floor(this.sunDrainAcc / SUN_DRAIN_TICK);
        this.sunDrainAcc -= ticks * SUN_DRAIN_TICK;
        this.sun = Math.max(0, this.sun - drain * ticks);
      }
    } else {
      this.sunDrainAcc = 0;
    }
  }

  tickIdleSfx(dt) {
    for (const z of this.zombies) {
      if (z.dead) continue;

      z.idleTimer -= dt;
      if (z.idleTimer > 0) continue;

      z.idleLast = SFX.playIdle(z.idleLast);
      z.idleTimer = IDLE_GAP_MIN + Math.random() * (IDLE_GAP_MAX - IDLE_GAP_MIN);
    }
  }

  spawnThief(mode) {
    if (mode === 'steal') {
      const cands = [];
      for (const p of this.plants) {
        if (!p.dead && !p.abducted) cands.push(p);
      }
      if (!cands.length) return null;

      const p = cands[Math.floor(Math.random() * cands.length)];
      const t = new Zombie('thief_steal', p.row, centerX(p.col));
      t.thiefStage = 'mark';
      t.thiefT = 0;
      t.targetPlantId = p.id;
      t.targetX = centerX(p.col);
      t.targetY = centerY(p.row);
      t.targetRow = p.row;
      t.targetPlantType = p.type;
      this.addZombie(t);
      return t;
    }

    const row = this.pickRow();
    const col = DROP_COL_MIN + Math.floor(Math.random() * DROP_COLS);
    const carry = pickCarry('normal');

    const t = new Zombie('thief_drop', row, centerX(col));
    t.thiefStage = 'descend';
    t.thiefT = 0;
    t.dropLift = THIEF_HEIGHT;
    t.carryType = carry;
    t.targetX = centerX(col);
    t.targetY = centerY(row);
    t.targetRow = row;
    this.addZombie(t);

    SFX.playThief();
    return t;
  }

  spawnDropCarrier(carryType) {
    const type = ZOMBIE_TYPES[carryType] ? carryType : 'normal';
    const row = this.pickRow();
    const col = DROP_COL_MIN + Math.floor(Math.random() * DROP_COLS);

    const t = new Zombie('thief_drop', row, centerX(col));
    t.thiefStage = 'descend';
    t.thiefT = 0;
    t.dropLift = THIEF_HEIGHT;
    t.carryType = type;
    t.targetX = centerX(col);
    t.targetY = centerY(row);
    t.targetRow = row;
    this.addZombie(t);

    SFX.playThief();
    return t;
  }

  /* 绿桶空投：数量固定 3，不削减 */
  spawnGreenDrops(n) {
    for (let i = 0; i < n; i++) {
      let type;

      if (eliteMode === 'none') {
        type = GREEN_BASE_POOL[Math.floor(Math.random() * GREEN_BASE_POOL.length)];
      } else if (eliteMode === 'all') {
        const base = GREEN_DROP_POOL[Math.floor(Math.random() * GREEN_DROP_POOL.length)];
        type = forceEliteType(base);
      } else {
        type = GREEN_DROP_POOL[Math.floor(Math.random() * GREEN_DROP_POOL.length)];
      }

      this.spawnDropCarrier(type);
    }
  }

  /* 空投落地生成的僵尸与正常刷新完全一致 */
  releaseDrop(z) {
    const type = ZOMBIE_TYPES[z.carryType] ? z.carryType : 'normal';
    const row = z.targetRow;

    const nz = new Zombie(type, row, z.targetX);
    nz.x = z.targetX;
    this.addZombie(nz);

    this.fx.push({
      x: z.targetX, y: z.targetY, r: 44, t: 0.55, life: 0.55,
      color: '#e0a24b'
    });
  }

  retireThief(z) {
    z.dead = true;
    z.counted = true;
    z.deathDone = true;
    z.dieT = z.dieDur;
  }

  updateThief(z, dt) {
    if (z.slowTimer > 0) z.slowTimer = Math.max(0, z.slowTimer - dt);
    const slowFactor = z.slowTimer > 0 ? 0.5 : 1;
    const d = dt * slowFactor;

    z.thiefT += d;

    if (z.def.thief === 'drop') {
      if (z.thiefStage === 'descend') {
        const k = Math.min(1, z.thiefT / DROP_FALL);
        z.dropLift = THIEF_HEIGHT * (1 - k);
        if (k >= 1) {
          z.dropLift = 0;
          z.thiefStage = 'lift';
          z.thiefT = 0;
          this.releaseDrop(z);
        }
        return;
      }

      const k = Math.min(1, z.thiefT / THIEF_LEAVE);
      z.dropLift = THIEF_HEIGHT * k;
      if (k >= 1) this.retireThief(z);
      return;
    }

    if (z.thiefStage === 'mark') {
      if (z.thiefT >= THIEF_MARK) {
        z.thiefStage = 'descend';
        z.thiefT = 0;
        z.dropLift = THIEF_HEIGHT;
        SFX.playThief();
      }
      return;
    }

    if (z.thiefStage === 'descend') {
      const k = Math.min(1, z.thiefT / STEAL_FALL);
      z.dropLift = THIEF_HEIGHT * (1 - k);
      if (k >= 1) {
        z.dropLift = 0;
        z.thiefStage = 'hover';
        z.thiefT = 0;
      }
      return;
    }

    /* 悬停阶段：植物被铲走不打断，计时满才结算 */
    if (z.thiefStage === 'hover') {
      if (z.thiefT >= THIEF_HOVER) {
        const col = colOfX(z.targetX);
        const p = this.inBounds(col, z.targetRow)
          ? this.grid[z.targetRow][col]
          : null;

        z.thiefStage = 'lift';
        z.thiefT = 0;
        z.dropLift = 0;

        if (p && !p.dead && !p.abducted) {
          z.stolen = true;
          z.targetPlantId = p.id;
          z.targetPlantType = p.type;
          p.abducted = true;
        } else {
          z.stolen = false;
          z.targetPlantId = 0;
          z.targetPlantType = '';
        }
      }
      return;
    }

    const k = Math.min(1, z.thiefT / THIEF_LEAVE);
    z.dropLift = THIEF_HEIGHT * k;
    if (k >= 1) {
      if (z.stolen) {
        const p = this.plantById(z.targetPlantId);
        if (p && !p.dead) {
          p.dead = true;
          if (this.inBounds(p.col, p.row) && this.grid[p.row][p.col] === p) {
            this.grid[p.row][p.col] = null;
          }
        }
      }
      this.retireThief(z);
    }
  }

  leftmostPlantCol() {
    let best = -1;
    for (const p of this.plants) {
      if (p.dead || p.abducted) continue;
      if (best < 0 || p.col < best) best = p.col;
    }
    return best;
  }

  poleLeftCells(z) {
    if (!z.def.poleTier) return 0;
    if (z.type === 'elite_pole2') {
      const list = z.def.jumpList || [2, 4];
      return list[Math.min(z.jumpIndex, list.length - 1)];
    }
    if (z.def.poleTier === 1) return 1;
    return 2;
  }

  tryVault(z, row) {
    if (!z.def.poleTier || z.poleLeft <= 0) return false;

    const frontCol = Math.floor((z.x - 30 - FIELD.x) / CELL.w);
    const ahead = this.inBounds(frontCol, row) ? this.grid[row][frontCol] : null;
    if (!ahead || ahead.dead || ahead.abducted) return false;

    const cells = this.poleLeftCells(z);
    if (cells <= 0) return false;

    const land = Math.min(z.x - cells * CELL.w, cellX(frontCol) - 14);

    z.skipPlantId = ahead.id;
    z.jumpFrom = z.x;
    z.jumpTo = land;
    z.jumpT = 0;
    z.jumpDur = 0.28 + cells * 0.09;
    z.eating = false;
    z.eatTimer = 0;
    z.jumped++;
    z.jumpIndex++;

    this.vaultTrails.push({ x1: z.x, x2: land, y: z.y, t: 0.7, life: 0.7 });

    SFX.play('polejump');

    return true;
  }

  settleVault(z) {
    if (z.type === 'elite_pole2') {
      z.poleLeft -= 1;
      if (z.poleLeft <= 0) {
        z.poleLeft = 0;
        z.speed = z.def.speed;
      }
    } else if (z.type === 'elite_poleinf') {
      const carry = z.armor >= 400 ? 'bucket' : (z.armor > 0 ? 'cone' : 'normal');
      this.addZombie(new Zombie(carry, z.row, z.x - CELL.w));
    } else if (z.def.flagJump) {
      this.spawnExtraSurge(this.waveCap(Math.max(1, this.waveIndex)));
      z.poleLeft = 0;
      z.speed = z.def.speed;
    } else {
      z.poleLeft = 0;
      z.speed = z.def.poleSpeed || z.def.speed;
    }
  }

  poleToFriendly(z) {
    z.poleLeft = 0;
    z.friendly = true;
    z.speed = z.def.speed * 0.8;
    z.eating = false;
    z.eatTimer = 0;
    this.fx.push({ x: z.x, y: z.y, r: 46, t: 0.6, life: 0.6, color: '#ff8ad8' });
  }

  spawnExtraSurge(cap) {
    SFX.play('surgeOn');

    this.surgePhase = SURGE.BANNER;
    this.surgeTimer = 2.2;
    this.surgeText = '一大波僵尸来袭';

    this.pending.push({
      at: this.time,
      type: this.rollFlag(),
      row: this.pickRow()
    });

    const pool = this.typePool(Math.max(1, this.waveIndex));
    const n = Math.max(2, cap);
    let sum = 0;
    for (const p of pool) sum += p.w;

    for (let i = 0; i < n; i++) {
      if (this.pending.length >= ENDLESS.pendingMax) break;
      let r = Math.random() * sum;
      let pick = pool[0];
      for (const p of pool) {
        r -= p.w;
        if (r <= 0) { pick = p; break; }
      }
      this.pending.push({
        at: this.time + (i + 1) * 0.35,
        type: pick.type,
        row: this.pickRow()
      });
    }
  }

  updateFriendly(z, dt) {
    if (z.slowTimer > 0) z.slowTimer = Math.max(0, z.slowTimer - dt);
    const slowFactor = z.slowTimer > 0 ? 0.5 : 1;

    let prey = null;
    let bestD = Infinity;
    for (const o of this.zombies) {
      if (o === z) continue;
      if (o.dead || o.friendly || o.def.thief) continue;
      const d = Math.abs(o.x - z.x) + Math.abs(o.row - z.row) * CELL.w * 0.5;
      if (d < bestD) { bestD = d; prey = o; }
    }

    if (prey && bestD < CELL.w * 0.8) {
      z.eating = true;
      z.eatTimer += dt * slowFactor;
      if (z.eatTimer >= 0.5) {
        z.eatTimer -= 0.5;
        prey.hurt(z.def.dps * 0.5);
      }
      return;
    }

    z.eating = false;
    z.eatTimer = 0;
    z.x -= walkSpeed(z) * slowFactor * dt;
    z.walkPhase += dt * 6 * slowFactor;

    if (z.x < FIELD.x - CELL.w) {
      z.dead = true;
      z.counted = true;
      z.deathDone = true;
      z.dieT = z.dieDur;
    }
  }

  onZombieDeath(z) {
    const kind = z.def.deathSpawn;
    if (!kind) return;

    if (kind === 'thief') {
      this.spawnThief('drop');
      return;
    }

    if (kind === 'thief_steal') {
      this.spawnThief('steal');
      return;
    }

    if (kind === 'greendrop') {
      this.spawnGreenDrops(3);
      return;
    }

    if (kind === 'reds') {
      const spots = [
        { row: z.row, x: z.x - CELL.w },
        { row: z.row, x: z.x + CELL.w },
        { row: z.row - 1, x: z.x },
        { row: z.row + 1, x: z.x }
      ];

      for (const s of spots) {
        if (s.row < 0 || s.row >= GRID.rows) continue;
        if (s.x < FIELD.x || s.x > FIELD.x + FIELD.w) continue;

        this.addZombie(new Zombie('red', s.row, s.x));

        this.fx.push({
          x: s.x, y: centerY(s.row), r: 30, t: 0.5, life: 0.5,
          color: '#e8564a'
        });
      }
    }
  }

  updateZombies(dt) {
    const deads = [];
    for (const z of this.zombies) {
      if (z.dead && !z.deathDone) {
        z.deathDone = true;
        if (!z.def.thief) deads.push(z);
      }
    }
    for (const z of deads) this.onZombieDeath(z);

    this.applyFlagAura(dt);

    this.tickIdleSfx(dt);

    const n = this.zombies.length;

    for (let i = 0; i < n; i++) {
      const z = this.zombies[i];
      if (z.dead) continue;

      if (z.biteFlash > 0) z.biteFlash = Math.max(0, z.biteFlash - dt);

      if (z.def.thief) {
        this.updateThief(z, dt);
        continue;
      }

      if (z.friendly) {
        this.updateFriendly(z, dt);
        continue;
      }

      if (z.slowTimer > 0) z.slowTimer = Math.max(0, z.slowTimer - dt);
      const slowFactor = z.slowTimer > 0 ? 0.5 : 1;

      if (z.def.goldRage) {
        if (z.goldShieldT > 0) z.goldShieldT = Math.max(0, z.goldShieldT - dt);
        if (!z.goldRaged && z.armor <= 0) {
          z.goldRaged = true;
          z.goldShieldT = GOLD_SHIELD_DUR;
          z.speed = z.def.speed * GOLD_SPEED_MUL;
        }
      }

      if (z.shifting) {
        z.shiftT = Math.max(0, z.shiftT - dt);
        const k = z.shiftDur > 0 ? 1 - z.shiftT / z.shiftDur : 1;
        z.shiftY = -z.shiftDir * CELL.h * (1 - k);
        z.walkPhase += dt * 7;
        if (z.shiftT <= 0) {
          z.shiftY = 0;
          z.shiftDir = 0;
        }
        continue;
      }

      if (z.airborne) {
        z.jumpT += dt;
        const k = Math.min(1, z.jumpT / z.jumpDur);
        z.x = z.jumpFrom + (z.jumpTo - z.jumpFrom) * k;
        z.jumpLift = Math.sin(Math.PI * k) * VAULT_LIFT;
        z.walkPhase += dt * 9;
        if (k >= 1) {
          z.jumpLift = 0;
          z.jumpDur = 0;
          z.jumpT = 0;
          z.speed = z.def.poleSpeed || z.def.speed;
          if (!z.friendly) this.settleVault(z);
        }
        continue;
      }

      if (z.def.healAura) {
        z.healTimer -= dt;
        if (z.healTimer <= 0) {
          z.healTimer = HEAL_INTERVAL;
          this.healAround(z);
        }
      }

      if (z.def.garlic) {
        z.garlicTimer -= dt;
        if (z.garlicTimer <= 0) {
          z.garlicTimer = GARLIC_INTERVAL;
          this.startLaneShift(z);
          continue;
        }
      }

      if (z.def.rage && !z.enraged && z.hpRatio <= 0.5) {
        z.enraged = true;
        z.speed = z.def.speed * 2;
      }

      const row = z.row;
      let bodyCol = colOfX(z.x);

      if (this.inBounds(bodyCol, row)) {
        const here = this.grid[row][bodyCol];
        if (here && !here.dead && centerX(bodyCol) > z.x + ATTACK_REACH) bodyCol -= 1;
      }

      if (z.hasPole && this.tryVault(z, row)) continue;

      if (z.type === 'elite_poleinf' && z.hasPole) {
        const leftCol = this.leftmostPlantCol();
        if (leftCol < 0 || z.x < cellX(leftCol) - CELL.w * 0.5) {
          this.poleToFriendly(z);
          continue;
        }
      }

      if (z.def.ignorePlants) {
        z.eating = false;
        z.eatTimer = 0;
        z.x -= walkSpeed(z) * slowFactor * dt;
        z.walkPhase += dt * 7 * slowFactor;
        if (z.x < ZOMBIE_LOSE_X) {
          this.state = STATE.LOST;
          return;
        }
        continue;
      }

      const target = this.inBounds(bodyCol, row) ? this.grid[row][bodyCol] : null;
      const eatable = !!(target && !target.dead && !target.abducted
        && target.id !== z.skipPlantId);

      if (eatable) {
        z.eating = true;
        z.eatTimer += dt * slowFactor;
        if (z.eatTimer >= EAT_TICK) {
          z.eatTimer -= EAT_TICK;
          target.hurt(z.def.dps * EAT_TICK);
          SFX.playBite();
          if (target.dead) {
            SFX.play('planteat');
            if (this.grid[row][bodyCol] === target) {
              this.grid[row][bodyCol] = null;
            }
          }
        }
      } else {
        z.eating = false;
        z.eatTimer = 0;
        z.x -= walkSpeed(z) * slowFactor * dt;
        z.walkPhase += dt * 6 * slowFactor;
      }

      if (z.x < ZOMBIE_LOSE_X) {
        this.state = STATE.LOST;
        return;
      }
    }
  }

  updateSuns(dt) {
    for (const s of this.suns) {
      if (s.dead) continue;
      if (s.y < s.targetY) {
        s.y = Math.min(s.targetY, s.y + SUN_FALL_SPEED * dt);
      } else {
        s.life -= dt;
        if (s.life <= 0) s.dead = true;
      }
    }
  }

  updateFx(dt) {
    for (let i = this.fx.length - 1; i >= 0; i--) {
      this.fx[i].t -= dt;
      if (this.fx[i].t <= 0) this.fx.splice(i, 1);
    }
  }

  updateTrails(dt) {
    for (let i = this.vaultTrails.length - 1; i >= 0; i--) {
      this.vaultTrails[i].t -= dt;
      if (this.vaultTrails[i].t <= 0) this.vaultTrails.splice(i, 1);
    }
  }

  collectSun(px, py) {
    if (this.state !== STATE.PLAYING) return 0;

    const r2 = SUN_PICK_RADIUS * SUN_PICK_RADIUS;
    let got = 0;

    for (const s of this.suns) {
      if (s.dead) continue;
      const dx = s.x - px;
      const dy = s.y - py;
      if (dx * dx + dy * dy > r2) continue;
      s.collect();
      got += s.value;
    }

    if (got > 0) {
      this.sun += got;
      SFX.play('sun');
    }

    return got;
  }

  laneLoad() {
    const load = new Array(GRID.rows).fill(0);

    for (const e of this.pending) {
      if (e.row >= 0 && e.row < GRID.rows) load[e.row] += 1;
    }

    for (const z of this.zombies) {
      if (z.dead || z.friendly) continue;
      if (z.row >= 0 && z.row < GRID.rows) load[z.row] += 1;
    }

    return load;
  }

  pickRow(exclude) {
    const ex = typeof exclude === 'number' ? exclude : -1;
    const load = this.laneLoad();

    const cands = [];
    let sum = 0;

    for (let r = 0; r < GRID.rows; r++) {
      if (r === ex) continue;
      const n = 1 + load[r];
      const w = 1 / (n * n);
      cands.push({ r: r, w: w });
      sum += w;
    }

    if (!cands.length) return -1;

    let v = Math.random() * sum;
    for (const c of cands) {
      v -= c.w;
      if (v <= 0) return c.r;
    }
    return cands[cands.length - 1].r;
  }

  waveCap(n) {
    const tenth = ENDLESS.capBase + (n - 1) * ENDLESS.capStep;
    return Math.floor((tenth + 1) / 10);
  }

  get fieldLoad() {
    let s = 0;
    for (let i = 0; i < this.pending.length; i++) {
      const t = ZOMBIE_TYPES[this.pending[i].type];
      if (t) s += t.cost;
    }
    for (let i = 0; i < this.zombies.length; i++) {
      const z = this.zombies[i];
      if (z.dead) continue;
      s += z.def.cost;
    }
    return s;
  }

  typePool(n) {
    const pool = [{ type: 'normal', w: 100 }];
    if (n >= 3) pool.push({ type: 'cone', w: Math.min(60, (n - 2) * 6) });
    if (n >= 5) pool.push({ type: 'bucket', w: Math.min(30, (n - 4) * 3) });
    if (n >= 7) pool.push({ type: 'pole', w: Math.min(45, (n - 6) * 5) });
    return pool;
  }

  buildWave(n, cap) {
    const pool = this.typePool(n);
    const out = [];
    let left = cap;
    let guard = 128;

    while (left > 0 && guard-- > 0) {
      let fit = null;
      let sum = 0;
      for (const p of pool) {
        if (ZOMBIE_TYPES[p.type].cost <= left) {
          sum += p.w;
          if (!fit) fit = [];
          fit.push(p);
        }
      }
      if (!fit) break;

      let r = Math.random() * sum;
      let pick = fit[0];
      for (const p of fit) {
        r -= p.w;
        if (r <= 0) { pick = p; break; }
      }

      out.push(pick.type);
      left -= ZOMBIE_TYPES[pick.type].cost;
    }

    if (!out.length) out.push('normal');
    return out;
  }

  updateWaves(dt) {
    this.flushPending();

    if (this.surgePhase === SURGE.BANNER) {
      this.surgeTimer -= dt;
      if (this.surgeTimer > 0) return;

      this.surgePhase = SURGE.NONE;
      this.surgeTimer = 0;
      this.spawnSurge();
      this.waveTimer = ENDLESS.waveGap;
      return;
    }

    const curCap = this.waveCap(Math.max(1, this.waveIndex));

    if (curCap >= LOAD_MODE_CAP && this.waveIndex > 0) {
      if (this.fieldLoad * 2 > curCap) return;
      this.advanceWave();
      return;
    }

    if (this.waveTimer > 0) {
      this.waveTimer = Math.max(0, this.waveTimer - dt);
      if (this.waveIndex > 0 && this.isFieldClear()) this.waveTimer = 0;
    }

    if (this.waveTimer > 0) return;

    this.advanceWave();
  }

  advanceWave() {
    if (this.waveIndex > 0 && this.waveIndex % ENDLESS.surgeEvery === 0) {
      SFX.play('surge');
      this.surgePhase = SURGE.BANNER;
      this.surgeTimer = ENDLESS.surgeBanner;
      return;
    }

    this.spawnWave();
    this.waveTimer = ENDLESS.waveGap;
  }

  isFieldClear() {
    if (this.pending.length) return false;
    for (const z of this.zombies) {
      if (!z.dead) return false;
    }
    return true;
  }

  spawnWave() {
    this.waveIndex++;
    const n = this.waveIndex;
    const cap = this.waveCap(n);
    const list = this.buildWave(n, cap);

    for (let i = 0; i < list.length; i++) {
      if (this.pending.length >= ENDLESS.pendingMax) break;
      this.pending.push({
        at: this.time + i * ENDLESS.stagger,
        type: list[i],
        row: this.pickRow()
      });
    }
  }

  spawnSurge() {
    SFX.play('surgeOn');

    this.waveIndex++;
    const n = this.waveIndex;
    const cap = Math.max(
      ENDLESS.surgeMinCap,
      Math.ceil(this.waveCap(n) * ENDLESS.surgeMul)
    );

    this.pending.push({
      at: this.time,
      type: this.rollFlag(),
      row: this.pickRow()
    });

    const list = this.buildWave(n, cap);
    for (let i = 0; i < list.length; i++) {
      if (this.pending.length >= ENDLESS.pendingMax) break;
      this.pending.push({
        at: this.time + (i + 1) * ENDLESS.surgeStagger,
        type: list[i],
        row: this.pickRow()
      });
    }
  }

  rollFlag() {
    if (!eliteRoll()) return 'flag';

    const pool = ELITE_POOLS.flag;
    return pool[Math.floor(Math.random() * pool.length)];
  }

  rollTypes(type) {
    const pool = ELITE_POOLS[type];
    if (!pool || !pool.length) return [type];

    if (!eliteRoll()) return [type];
    return [pool[Math.floor(Math.random() * pool.length)]];
  }

  flushPending() {
    if (!this.pending.length) return;

    for (let i = this.pending.length - 1; i >= 0; i--) {
      const e = this.pending[i];
      if (e.at > this.time) continue;
      this.pending.splice(i, 1);

      const types = e.plain ? [e.type] : this.rollTypes(e.type);

      for (let k = 0; k < types.length; k++) {
        const row = k === 0 ? e.row : this.pickRow(e.row);
        this.addZombie(new Zombie(
          types[k], row,
          ZOMBIE_SPAWN_X + Math.random() * SPAWN_JITTER
        ));
      }
    }
  }

  cleanup() {
    for (const z of this.zombies) {
      if (z.dead && !z.counted) {
        z.counted = true;
        if (!z.def.thief && !z.friendly) this.killed++;
      }
    }

    this.zombies = this.zombies.filter((z) => {
      if (!z.dead) return true;
      return z.dieT < z.dieDur;
    });

    this.plants = this.plants.filter((p) => !p.dead);
    this.bullets = this.bullets.filter((b) => !b.dead);
    this.suns = this.suns.filter((s) => !s.dead);

    for (let r = 0; r < GRID.rows; r++) {
      const line = this.grid[r];
      for (let c = 0; c < GRID.cols; c++) {
        if (line[c] && line[c].dead) line[c] = null;
      }
    }
  }

  serialize() {
    if (this.state !== STATE.PLAYING && this.state !== STATE.PAUSED) return null;

    const plants = [];
    for (const p of this.plants) {
      if (p.dead) continue;
      plants.push({
        t: p.type, c: p.col, r: p.row,
        hp: p.hp, ft: p.fireTimer, st: p.sunTimer,
        fu: p.fuseTimer, ex: p.exploded,
        dg: p.digest, bt: p.biteT,
        at: p.armTimer, et: p.emergeT,
        ab: p.abducted ? 1 : 0
      });
    }

    const zombies = [];
    for (const z of this.zombies) {
      if (z.dead) continue;
      zombies.push({
        t: z.type, r: z.row, x: z.x, hp: z.hp, ar: z.armor, a2: z.armor2,
        sp: z.speed, sb: z.speedBoost, rb: z.roadBuffed ? 1 : 0,
        sl: z.slowTimer, e2: z.eatTimer,
        ea: z.eating ? 1 : 0, wp: z.walkPhase,
        vt: z.vaulted ? 1 : 0, sk: z.skipPlantId,
        jf: z.jumpFrom, jt: z.jumpTo, jT: z.jumpT,
        jD: z.jumpDur, jL: z.jumpLift,
        sT: z.shiftT, sD: z.shiftDur, sR: z.shiftDir,
        sY: z.shiftY, gt: z.garlicTimer,
        en: z.enraged ? 1 : 0, hl: z.healTimer, dd: z.deathDone ? 1 : 0,
        pl: z.poleLeft, ji: z.jumpIndex,
        fr: z.friendly ? 1 : 0,
        gs: z.goldShieldT, gr: z.goldRaged ? 1 : 0,
        fs: z.slowSfxDone ? 1 : 0,
        it: z.idleTimer,
        il: z.idleLast,
        ts: z.thiefStage, tt: z.thiefT, dl: z.dropLift,
        ct: z.carryType, tp: z.targetPlantId,
        tx: z.targetX, ty: z.targetY, pt: z.targetPlantType,
        so: z.stolen ? 1 : 0
      });
    }

    return {
      v: 6,
      sun: this.sun,
      time: this.time,
      sunTimer: this.sunTimer,
      sunDrainAcc: this.sunDrainAcc,
      waveIndex: this.waveIndex,
      waveTimer: this.waveTimer,
      state: this.state,
      surgePhase: this.surgePhase,
      surgeTimer: this.surgeTimer,
      killed: this.killed,
      cooldowns: this.cooldowns,
      pending: this.pending.map((e) => ({
        at: e.at, type: e.type, row: e.row, plain: e.plain ? 1 : 0
      })),
      plants: plants,
      zombies: zombies,
      bullets: this.bullets.filter((b) => !b.dead).map((b) => ({
        x: b.x, y: b.y, r: b.row, d: b.damage, s: b.slow,
        sn: b.isSnow ? 1 : 0, k: b.kind, sp: b.splash
      })),
      suns: this.suns.filter((s) => !s.dead).map((s) => ({
        x: s.x, y: s.y, ty: s.targetY, v: s.value, l: s.life
      }))
    };
  }

  hydrate(d) {
    this.reset();

    this.sun = typeof d.sun === 'number' ? d.sun : SUN_START;
    this.time = d.time || 0;
    this.sunTimer = d.sunTimer || 0;
    this.sunDrainAcc = d.sunDrainAcc || 0;
    this.waveIndex = d.waveIndex || 0;
    this.waveTimer = typeof d.waveTimer === 'number' ? d.waveTimer : 0;
    this.state = d.state === STATE.PAUSED ? STATE.PAUSED : STATE.PLAYING;
    this.surgePhase = d.surgePhase === SURGE.BANNER ? SURGE.BANNER : SURGE.NONE;
    this.surgeTimer = d.surgeTimer || 0;
    this.killed = d.killed || 0;

    if (d.cooldowns) {
      for (const k of Object.keys(this.cooldowns)) {
        if (typeof d.cooldowns[k] === 'number') this.cooldowns[k] = d.cooldowns[k];
      }
    }

    this.pending = [];
    if (Array.isArray(d.pending)) {
      for (const e of d.pending) {
        if (!e || !ZOMBIE_TYPES[e.type]) continue;
        this.pending.push({
          at: e.at || 0, type: e.type, row: e.row | 0, plain: e.plain ? 1 : 0
        });
      }
    }

    this.plants = [];
    this.grid = [];
    for (let r = 0; r < GRID.rows; r++) this.grid.push(new Array(GRID.cols).fill(null));

    if (Array.isArray(d.plants)) {
      for (const o of d.plants) {
        if (!o || !PLANT_TYPES[o.t]) continue;
        if (!this.inBounds(o.c, o.r)) continue;
        const p = new Plant(o.t, o.c, o.r);
        if (typeof o.hp === 'number') p.hp = o.hp;
        p.fireTimer = o.ft || 0;
        p.sunTimer = o.st || 0;
        if (typeof o.fu === 'number') p.fuseTimer = o.fu;
        p.exploded = !!o.ex;
        p.digest = o.dg || 0;
        p.biteT = o.bt || 0;
        if (typeof o.at === 'number') p.armTimer = o.at;
        p.emergeT = o.et || 0;
        p.abducted = !!o.ab;
        this.plants.push(p);
        if (!p.abducted) this.grid[p.row][p.col] = p;
      }
    }

    this.zombies = [];
    if (Array.isArray(d.zombies)) {
      for (const o of d.zombies) {
        if (!o || !ZOMBIE_TYPES[o.t]) continue;
        const z = new Zombie(o.t, o.r | 0, o.x || 0);
        if (typeof o.hp === 'number') z.hp = o.hp;
        if (typeof o.ar === 'number') z.armor = o.ar;
        if (typeof o.a2 === 'number') z.armor2 = o.a2;
        if (typeof o.sp === 'number') z.speed = o.sp;
        z.speedBoost = o.sb || 0;
        z.roadBuffed = !!o.rb;
        z.slowTimer = o.sl || 0;
        z.eatTimer = o.e2 || 0;
        z.eating = !!o.ea;
        z.walkPhase = o.wp || 0;
        z.vaulted = !!o.vt;
        z.skipPlantId = o.sk || 0;
        z.jumpFrom = o.jf || 0;
        z.jumpTo = o.jt || 0;
        z.jumpT = o.jT || 0;
        z.jumpDur = o.jD || 0;
        z.jumpLift = o.jL || 0;
        z.shiftT = o.sT || 0;
        z.shiftDur = o.sD || 0;
        z.shiftDir = o.sR || 0;
        z.shiftY = o.sY || 0;
        z.garlicTimer = typeof o.gt === 'number' ? o.gt : GARLIC_INTERVAL;
        z.enraged = !!o.en;
        z.healTimer = typeof o.hl === 'number' ? o.hl : HEAL_INTERVAL;
        z.deathDone = !!o.dd;
        if (typeof o.pl === 'number') z.poleLeft = o.pl;
        z.jumpIndex = o.ji || 0;
        z.friendly = !!o.fr;
        z.goldShieldT = o.gs || 0;
        z.goldRaged = !!o.gr;
        z.slowSfxDone = !!o.fs;
        z.idleLast = o.il || '';
        z.idleTimer = typeof o.it === 'number'
          ? o.it
          : IDLE_GAP_MIN + Math.random() * (IDLE_GAP_MAX - IDLE_GAP_MIN);
        z.thiefStage = o.ts || '';
        z.thiefT = o.tt || 0;
        z.dropLift = o.dl || 0;
        z.carryType = o.ct || '';
        z.targetPlantId = o.tp || 0;
        z.targetX = o.tx || 0;
        z.targetY = o.ty || 0;
        z.targetPlantType = o.pt || '';
        z.stolen = !!o.so;
        this.zombies.push(z);
      }
    }

    this.bullets = [];
    if (Array.isArray(d.bullets)) {
      for (const o of d.bullets) {
        if (!o) continue;
        this.bullets.push(new Bullet(
          o.x || 0, o.y || 0, o.r | 0, o.d || 0,
          o.s || 0, !!o.sn, o.k || 'pea', o.sp || 0
        ));
      }
    }

    this.suns = [];
    if (Array.isArray(d.suns)) {
      for (const o of d.suns) {
        if (!o) continue;
        const s = new SunToken(o.x || 0, o.y || 0, o.ty || 0, o.v || SUN_VALUE);
        s.life = o.l || SUN_LIFE;
        this.suns.push(s);
      }
    }

    this.fx = [];
    this.vaultTrails = [];

    this.firstZombieSfx = true;

    let maxId = 0;
    for (const p of this.plants) if (p.id > maxId) maxId = p.id;
    for (const z of this.zombies) if (z.id > maxId) maxId = z.id;
    for (const b of this.bullets) if (b.id > maxId) maxId = b.id;
    for (const s of this.suns) if (s.id > maxId) maxId = s.id;
    _uid = maxId + 1;

    return true;
  }
}

