function toCanvas(ev) {
  const rect = canvas.getBoundingClientRect();
  if (!rect.width || !rect.height) return null;
  return {
    x: (ev.clientX - rect.left) * (canvas.width / rect.width),
    y: (ev.clientY - rect.top) * (canvas.height / rect.height)
  };
}

function handlePointer(x, y) {
  if (game.state !== STATE.PLAYING) return;

  const got = game.collectSun(x, y);
  if (got > 0) {
    updateHud();
    return;
  }

  const cell = game.cellAt(x, y);
  if (!cell) return;

  if (shovelMode) {
    if (game.removeAt(cell.col, cell.row)) toggleShovel(false);
    else tip('这一格没有植物');
    return;
  }

  if (!selected) return;

  if (game.place(selected, cell.col, cell.row)) {
    selected = null;
    syncCards();
    tip(TIP_DEFAULT);
    return;
  }

  const def = PLANT_TYPES[selected];
  if ((game.cooldowns[selected] || 0) > 0) tip('还在冷却');
  else if (game.sun < def.cost) tip('阳光不足，还差 ' + (def.cost - game.sun));
  else tip('这一格已经有植物了');
}

function trackCherryFx() {
  const now = new Map();
  for (const p of game.plants) {
    if (p.type !== 'cherry' || p.dead) continue;
    now.set(p.id, { x: p.x, y: p.y, r: p.radius });
  }
  for (const [id, info] of lastCherries) {
    if (now.has(id)) continue;
    game.fx.push({ x: info.x, y: info.y, r: info.r, t: 0.45, life: 0.45 });
  }
  lastCherries = now;
}

function drawField() {
  for (let r = 0; r < GRID.rows; r++) {
    for (let c = 0; c < GRID.cols; c++) {
      ctx.fillStyle = (r + c) % 2 === 0 ? COLORS.lawn1 : COLORS.lawn2;
      ctx.fillRect(cellX(c), cellY(r), CELL.w, CELL.h);
    }
  }

  ctx.strokeStyle = COLORS.line;
  ctx.lineWidth = 1;
  for (let r = 0; r <= GRID.rows; r++) {
    ctx.beginPath();
    ctx.moveTo(FIELD.x, cellY(r));
    ctx.lineTo(FIELD.x + FIELD.w, cellY(r));
    ctx.stroke();
  }
  for (let c = 0; c <= GRID.cols; c++) {
    ctx.beginPath();
    ctx.moveTo(cellX(c), FIELD.y);
    ctx.lineTo(cellX(c), FIELD.y + FIELD.h);
    ctx.stroke();
  }
}

function drawHpBar(cx, cy, w, ratio, color) {
  ctx.fillStyle = 'rgba(0,0,0,0.45)';
  ctx.fillRect(cx - w / 2, cy, w, 4);
  ctx.fillStyle = color;
  ctx.fillRect(cx - w / 2, cy, w * Math.max(0, Math.min(1, ratio)), 4);
}

function plantSpriteAt(p, cx, cy, scale) {
  const im = PLANT_IMG[p.type];

  if (im) {
    const sw = im.naturalWidth;
    const sh = im.naturalHeight;
    if (sw > 0 && sh > 0) {
      const k = Math.min(PLANT_IMG_BOX / sw, PLANT_IMG_BOX / sh) * scale;
      const w = sw * k;
      const h = sh * k;
      ctx.drawImage(im, cx - w / 2, cy - h / 2, w, h);
      return;
    }
  }

  ctx.font = Math.round(40 * scale) + 'px ' + EMOJI;
  ctx.fillText(p.def.icon, cx, cy);
}

function drawPlants() {
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';

  const t = performance.now() / 1000;

  for (const p of game.plants) {
    if (p.dead || p.abducted) continue;

    if (p.type === 'potatomine' && p.armTimer > 0) {
      ctx.fillStyle = 'rgba(0,0,0,0.28)';
      ctx.beginPath();
      ctx.arc(p.x, p.y, 26, 0, Math.PI * 2);
      ctx.fill();

      ctx.font = '700 30px ' + CJK;
      ctx.fillStyle = 'rgba(255, 213, 79, 0.92)';
      ctx.fillText('埋', p.x, p.y + 1);

      const w = 44;
      const done = 1 - p.armTimer / (p.def.armTime || 10);
      ctx.fillStyle = 'rgba(0,0,0,0.5)';
      ctx.fillRect(p.x - w / 2, p.y + 30, w, 4);
      ctx.fillStyle = '#ffd54f';
      ctx.fillRect(p.x - w / 2, p.y + 30, w * Math.max(0, Math.min(1, done)), 4);

      if (p.hpRatio < 1) drawHpBar(p.x, p.y + 40, 40, p.hpRatio, '#66bb6a');
      continue;
    }

    let scale = 1;
    let dx = 0;
    let dy = 0;
    let alpha = 1;

    const phase = (p.id % 12) * 0.53;
    dy += Math.sin(t * 1.9 + phase) * 1.6;
    dx += Math.sin(t * 1.27 + phase * 1.7) * 1.4;
    scale += Math.sin(t * 1.6 + phase) * 0.012;

    if (p.type === 'cherry' && p.armed && !p.exploded) {
      const span = p.def.fuse || DEFAULT_FUSE;
      const left = Math.max(0, p.fuseTimer) / span;
      const grow = 1 - left;
      scale = 1 + grow * grow * 0.52;
      alpha = 0.62 + 0.38 * Math.abs(Math.sin(grow * 15));
    }

    if (p.type === 'chomper' && p.biteT > 0) {
      const k = 1 - p.biteT / BITE_DUR;
      const lunge = Math.sin(k * Math.PI);
      dx += lunge * 18;
      dy -= lunge * 4;
      scale = 1 + lunge * 0.2;
    }

    if (p.type === 'sunflower' && p.pulseT > 0) {
      dy -= Math.sin((1 - p.pulseT / SUN_PULSE) * Math.PI) * 8;
    }

    if (p.type === 'potatomine' && p.emergeT > 0) {
      const k = 1 - p.emergeT / EMERGE_DUR;
      dy += (1 - k) * 24;
      scale = 0.55 + 0.45 * k;
      alpha = 0.6 + 0.4 * k;
    }

    if (p.flashT > 0) {
      dx -= (p.flashT / SHOOT_FLASH) * 7;
    }

    ctx.globalAlpha = alpha;
    plantSpriteAt(p, p.x + dx, p.y + dy, scale);
    ctx.globalAlpha = 1;

    if (p.type === 'chomper' && p.digest > 0) {
      ctx.font = '700 13px ' + CJK;
      ctx.fillStyle = '#ffd54f';
      ctx.fillText('消化中', p.x, p.y - 34);

      const w = 40;
      const done = 1 - p.digest / (p.def.digest || 20);
      ctx.fillStyle = 'rgba(0,0,0,0.5)';
      ctx.fillRect(p.x - w / 2, p.y - 26, w, 3);
      ctx.fillStyle = '#ffd54f';
      ctx.fillRect(p.x - w / 2, p.y - 26, w * Math.max(0, Math.min(1, done)), 3);
    }

    if (p.hpRatio > 0 && p.hpRatio < 1) {
      drawHpBar(p.x, p.y + 34, 40, p.hpRatio, '#66bb6a');
    }
  }
}

