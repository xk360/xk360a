  for (const key of Object.keys(PLANT_TYPES)) {
    const def = PLANT_TYPES[key];
    if (!def.img) continue;

    const im = new Image();
    im.decoding = 'async';
    im.onload = function () {
      if (im.naturalWidth > 0 && im.naturalHeight > 0) PLANT_IMG[key] = im;
      else PLANT_IMG[key] = null;
    };
    im.onerror = function () {
      PLANT_IMG[key] = null;
    };
    im.src = def.img;
  }
}

