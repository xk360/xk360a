function drawSunHead(z, yy) {
  const cy = yy - 8;
  const t = performance.now() / 1000;

  ctx.fillStyle = 'rgba(255, 213, 79, 0.28)';
  ctx.beginPath();
  ctx.arc(z.x, cy, 25, 0, Math.PI * 2);
  ctx.fill();

  ctx.fillStyle = '#f9a825';
  for (let i = 0; i < 8; i++) {
    const a = t * 0.8 + (Math.PI / 4) * i;
    ctx.beginPath();
    ctx.moveTo(z.x + Math.cos(a) * 12, cy + Math.sin(a) * 12);
    ctx.lineTo(z.x + Math.cos(a) * 24, cy + Math.sin(a) * 24);
    ctx.lineTo(z.x + Math.cos(a + 0.24) * 12, cy + Math.sin(a + 0.24) * 12);
    ctx.closePath();
    ctx.fill();
  }

  const g = ctx.createRadialGradient(z.x, cy, 2, z.x, cy, 13);
  g.addColorStop(0, '#fff9c4');
  g.addColorStop(1, '#f9a825');
  ctx.fillStyle = g;
  ctx.beginPath();
  ctx.arc(z.x, cy, 13, 0, Math.PI * 2);
  ctx.fill();
}

function drawHair(z, yy) {
  ctx.fillStyle = '#1e1a18';

  ctx.beginPath();
  ctx.moveTo(z.x - 17, yy - 18);
  ctx.quadraticCurveTo(z.x - 21, yy + 10, z.x - 13, yy + 23);
  ctx.lineTo(z.x - 5, yy + 19);
  ctx.quadraticCurveTo(z.x - 10, yy - 2, z.x - 8, yy - 18);
  ctx.closePath();
  ctx.fill();

  ctx.beginPath();
  ctx.moveTo(z.x + 17, yy - 18);
  ctx.quadraticCurveTo(z.x + 21, yy + 10, z.x + 13, yy + 23);
  ctx.lineTo(z.x + 5, yy + 19);
  ctx.quadraticCurveTo(z.x + 10, yy - 2, z.x + 8, yy - 18);
  ctx.closePath();
  ctx.fill();
}

function drawFlag(z, yy) {
  const count = z.def.flagCount || 1;
  const color = z.def.flagColor || '#c62828';
  const up = yy - 44;
  const down = yy + 20;
  const spread = 24;
  const base = z.x + 28 - (count - 1) * spread / 2;

  for (let i = 0; i < count; i++) {
    const px = base + i * spread;
    const flap = Math.sin(z.walkPhase * 2 + i) * 2.5;

    ctx.strokeStyle = '#6d4c41';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(px, down);
    ctx.lineTo(px, up);
    ctx.stroke();

    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(px, up);
    ctx.lineTo(px + 26, up + 7 + flap);
    ctx.lineTo(px + 26, up + 18 + flap);
    ctx.lineTo(px, up + 17);
    ctx.closePath();
    ctx.fill();

    ctx.strokeStyle = 'rgba(255, 235, 160, 0.9)';
    ctx.lineWidth = 1.4;
    ctx.stroke();
  }
}

